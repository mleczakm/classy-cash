{% extends 'parent/layout.html.twig' %}

{% block page_content %}
<div class="p-8">
    <h1 class="text-2xl font-serif-brand font-bold text-[#1a2a52] mb-6">Mój Profil</h1>
    
    <div class="space-y-6">
        <div class="card-elegant p-6">
            <p class="text-[10px] font-bold uppercase tracking-widest text-[#6b7796] mb-1">Imię i nazwisko</p>
            <p class="font-bold text-[#1a2a52]">{{ app.user.name }}</p>
        </div>

        <div class="card-elegant p-6">
            <p class="text-[10px] font-bold uppercase tracking-widest text-[#6b7796] mb-1">Adres e-mail</p>
            <p class="font-bold text-[#1a2a52]">{{ app.user.email }}</p>
        </div>

        <a href="{{ path('app_logout') }}" class="w-full btn-outline flex items-center justify-center gap-2 text-red-500 border-red-100 hover:bg-red-50">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            Wyloguj się
        </a>
    </div>
</div>
{% endblock %}
