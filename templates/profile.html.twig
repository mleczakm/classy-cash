{% extends 'parent/layout.html.twig' %}

{% block page_content %}
<div class="flex flex-col min-h-full">
    <!-- Header to match Dashboard structure -->
    <div class="bg-[#1a2a52] p-8 text-white relative flex-shrink-0 rounded-b-[32px] shadow-lg mb-8">
        <div class="flex items-center gap-4 relative z-10">
            <div class="w-12 h-12 bg-[#e8b441] text-[#1a2a52] rounded-full flex items-center justify-center font-bold text-xl shadow-lg shadow-amber-200/20">
                {{ app.user.name|slice(0, 1)|upper }}
            </div>
            <div>
                <h1 class="text-2xl font-serif-brand font-bold text-white">Mój Profil</h1>
                <p class="text-[10px] font-bold uppercase opacity-60 tracking-widest">Ustawienia konta</p>
            </div>
        </div>
    </div>
    
    <div class="p-6 space-y-6 flex-1">
        <div class="bg-white rounded-3xl border border-slate-100 p-6 shadow-sm">
            <p class="text-[10px] font-bold uppercase tracking-widest text-[#6b7796] mb-2">Imię i nazwisko</p>
            <p class="font-bold text-[#1a2a52] text-lg">{{ app.user.name }}</p>
        </div>

        <div class="bg-white rounded-3xl border border-slate-100 p-6 shadow-sm">
            <p class="text-[10px] font-bold uppercase tracking-widest text-[#6b7796] mb-2">Adres e-mail</p>
            <p class="font-bold text-[#1a2a52]">{{ app.user.email }}</p>
        </div>

        <div class="pt-4">
            <a href="{{ path('app_logout') }}" class="w-full h-16 rounded-2xl flex items-center justify-center gap-3 text-red-500 font-bold border border-red-50 hover:bg-red-50 transition-colors shadow-sm bg-white">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                Wyloguj się
            </a>
        </div>
    </div>
</div>
{% endblock %}
