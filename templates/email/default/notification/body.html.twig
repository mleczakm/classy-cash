{% apply inky_to_html|inline_css %}
    <!DOCTYPE html>
    <html>
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <style>
            {% block style %}
            {{ source("@email/default/main.css") }}
            {% endblock %}
        </style>
    </head>
    <body>
    <center style="width: 100%; background-color: #f7f6f0; padding-bottom: 40px;">
        <table class="email-container {{ ("urgent" == importance ? "alert" : ("high" == importance ? "warning" : "default")) }}" role="presentation" cellpadding="0" cellspacing="0" width="600">
            <tr>
                <td class="header">
                    <div class="logo">{{ settings.getName()|upper }}</div>
                </td>
            </tr>
            <tr>
                <td class="content-area">
                    {% block lead %}
                        {% if importance is not null %}
                            <p style="margin: 0 0 8px 0;"><span class="badge" style="background-color: #1a2a52; color: #ffffff; padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight: bold;">{{ importance|trans|upper }}</span></p>
                        {% endif %}
                        <h1 style="font-size: 24px; margin: 0 0 20px 0; color: #1a2a52;">{{ email.subject }}</h1>
                    {% endblock %}

                    {% block content %}
                        {% if markdown %}
                            {{ include('@email/zurb_2/notification/content_markdown.html.twig') }}
                        {% else %}
                            {{ content matches '/<.*?>/s' or raw ? content|raw : content|nl2br }}
                        {% endif %}
                    {% endblock %}

                    {% block action %}
                        {% if action_url %}
                            <div style="text-align: center; margin-top: 20px;">
                                <a href="{{ action_url }}" class="button">{{ action_text|trans({}, 'emails') }}</a>
                            </div>
                            <p style="font-size: 14px; color: #6b7796;">{{ 'link_warning_upper'|trans({}, 'emails') }}</p>
                            <p class="help-text">{{ action_url }}</p>
                            <p style="font-size: 14px; color: #6b7796;">{{ 'link_warning_underlying'|trans({}, 'emails') }}</p>
                        {% endif %}
                    {% endblock %}

                    {% block exception %}
                        {% if exception %}
                            <p style="margin-top: 16px;"><em>{{ 'exception'|trans({}, 'emails') }}</em></p>
                        {% endif %}
                    {% endblock %}
                </td>
            </tr>
            <tr>
                <td class="footer">
                    Classy Cash — System zarządzania finansami klasowymi.<br>
                    Ta wiadomość została wysłana automatycznie. Prosimy na nią nie odpowiadać.
                </td>
            </tr>
        </table>
    </center>
    </body>
    </html>
{% endapply %}
