{% extends '@email/base_plain.html.twig' %}

{% block content %}
    <h1>Potwierdzenie płatności</h1>
    <p>Dziękujemy! Twoja płatność została zaksięgowana. Poniżej znajdziesz szczegóły rozliczenia składek.</p>

    <h3>Rozliczone składki</h3>
    <div class="card">
        <table class="data" role="presentation" cellpadding="0" cellspacing="0">
            <thead>
            <tr>
                <th>Uczeń</th>
                <th>Składka</th>
                <th style="text-align: right;">Kwota</th>
                <th style="text-align: right;">Status</th>
            </tr>
            </thead>
            <tbody>
            {% for item in items %}
                <tr>
                    <td>{{ item.student }}</td>
                    <td>{{ item.label }}</td>
                    <td style="text-align: right; white-space: nowrap;">{{ item.amount|money }}</td>
                    <td style="text-align: right; white-space: nowrap;" class="text-muted">{{ item.progress.paid }}/{{ item.progress.total }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <h3>Poprzednie wpłaty</h3>
    {% if previousPayments is defined and previousPayments is not empty %}
        <div class="card">
            <ul style="margin: 0; padding-left: 18px;">
                {% for p in previousPayments %}
                    <li style="margin-bottom: 8px;">
                        <span class="text-muted">{{ p.date|date('d.m.Y') }}:</span>
                        <strong>{{ p.amount|money }}</strong>
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% else %}
        <p class="text-muted">Brak wcześniejszych wpłat.</p>
    {% endif %}

    <div class="card">
        <p style="margin: 0;">Suma poprzednich wpłat: <strong>{{ sumPrevious|money }}</strong></p>
        <p style="margin: 8px 0 0 0;">Łącznie z tą wpłatą: <strong>{{ sumIncludingCurrent|money }}</strong></p>
    </div>

    <p>Dziękujemy za terminowe wpłaty i wsparcie!</p>
{% endblock %}
