{% extends '@email/base_plain.html.twig' %}

{% block content_cell_attr %} style="background-color: #f0fdf4;"{% endblock %}

{% block content %}
    <h1 class="text-success">Nowa wpłata w kasie!</h1>
    <p>System automatycznie zaksięgował wpłatę od rodzica:</p>
    <div class="card">
        <p style="margin: 0 0 8px 0;"><strong>Od:</strong> {{ parentName }} ({{ parentEmail }})</p>
        <p style="margin: 0 0 8px 0;"><strong>Klasa:</strong> {{ classRoomName }}</p>
    </div>

    <h3>Szczegóły wpłaty</h3>
    <div class="card">
        <ul style="margin: 0; padding-left: 18px;">
            {% for item in items %}
                <li style="margin-bottom: 8px;">
                    <strong>{{ item.student }}</strong>: {{ item.label }} —
                    {{ item.amount|money }}
                    {% if item.paidAt %}(opłacono: {{ item.paidAt|date('d.m.Y') }}){% endif %}
                    {% if item.dueAt %}(termin: {{ item.dueAt|date('d.m.Y') }}){% endif %}
                </li>
            {% endfor %}
        </ul>
    </div>

    <h3 style="color: #d65a4a;">Zaległe składki w klasie</h3>
    <p>Łączna kwota zaległości: <strong class="text-danger">{{ missingAmount|number_format(2, ',', ' ') }} PLN</strong></p>
    <p class="text-muted">W panelu możesz wysłać do rodziców automatyczne przypomnienia.</p>
{% endblock %}
