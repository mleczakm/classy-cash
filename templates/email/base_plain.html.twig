<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body { margin: 0; padding: 0; background-color: #f7f6f0; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #15203d; }
        .wrapper { width: 100%; table-layout: fixed; background-color: #f7f6f0; padding-bottom: 40px; }
        .main { background-color: #ffffff; margin: 0 auto; width: 100%; max-width: 600px; border-spacing: 0; font-family: sans-serif; color: #15203d; }
        .header { background-color: #1a2a52; padding: 30px; text-align: center; }
        .content { padding: 40px; line-height: 24px; font-size: 16px; }
        .footer { padding: 20px; text-align: center; font-size: 11px; color: #6b7796; }
        .button { display: inline-block; padding: 14px 30px; background-color: #e8b441; color: #1a2a52; text-decoration: none; border-radius: 10px; font-weight: bold; margin-top: 20px; }
        .card { background-color: #fcfcfc; border: 1px solid #e2e6ee; border-radius: 12px; padding: 20px; margin: 20px 0; }
        .badge { background-color: #1a2a52; color: #ffffff; padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight: bold; }
        h1 { font-size: 24px; margin: 0 0 20px 0; color: #1a2a52; }
        h2 { font-size: 20px; margin: 0 0 16px 0; color: #1a2a52; }
        h3 { font-size: 16px; margin: 16px 0 8px 0; color: #1a2a52; }
        p { margin: 0 0 16px 0; }
        table.data { width: 100%; border-collapse: collapse; font-size: 14px; }
        table.data th { border-bottom: 1px solid #e2e6ee; padding: 8px 0; text-align: left; color: #1a2a52; }
        table.data td { padding: 8px 0; border-bottom: 1px solid #f0f2f7; }
        .text-muted { color: #6b7796; font-size: 12px; }
        .text-success { color: #2aa57f; }
        .text-danger { color: #d65a4a; }
    </style>
</head>
<body>
<center class="wrapper">
    <table class="main" role="presentation" cellpadding="0" cellspacing="0" width="600">
        <tr>
            <td class="header">
                <div style="color: #e8b441; font-size: 24px; font-weight: bold; letter-spacing: 2px;">
                    {{ (tenant_name() ?? 'CLASSY CASH')|upper }}
                </div>
            </td>
        </tr>
        <tr>
            <td class="content"{% block content_cell_attr %}{% endblock %}>
                {% block content %}{{ content|raw }}{% endblock %}
            </td>
        </tr>
        <tr>
            <td class="footer">
                {% block footer %}
                    Classy Cash — System zarządzania finansami klasowymi.<br>
                    Ta wiadomość została wysłana automatycznie. Prosimy na nią nie odpowiadać.
                {% endblock %}
            </td>
        </tr>
    </table>
</center>
</body>
</html>
