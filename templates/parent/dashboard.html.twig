{% extends 'parent/layout.html.twig' %}

{% block page_content %}
<div id="p-dash" class="sub-view active h-full flex flex-col relative pb-20">
    <!-- Header with Balance -->
    <div class="bg-[#1a2a52] p-8 text-white relative flex-shrink-0 rounded-b-[32px] shadow-lg">
        <div class="flex justify-between items-start mb-8 relative z-10">
            <div>
                <p class="text-[10px] font-bold uppercase opacity-60 tracking-widest mb-1">Konto Rodzica</p>
                <h4 class="text-xl font-serif-brand font-bold text-white">{{ app.user.name }} <span class="text-[#e8b441]">{{ classRoom.name }}</span></h4>
            </div>
            <a href="{{ path('profile') }}" class="w-10 h-10 bg-white/10 hover:bg-white/20 transition-colors rounded-full flex items-center justify-center border border-white/20 font-bold shadow-md cursor-pointer">
                {{ app.user.name|slice(0, 2)|upper }}
            </a>
        </div>

        <div class="bg-white/10 backdrop-blur-md p-6 rounded-3xl border border-white/10 relative z-10 shadow-lg">
            <p class="text-[10px] uppercase font-bold text-blue-200 mb-1">Suma do uregulowania</p>
            <div class="flex justify-between items-baseline">
                <span class="text-4xl font-serif-brand font-bold text-[#e8b441]">{{ totalUnpaid|money }}</span>
                {% if totalUnpaid.amount.greaterThan(0) %}
                    <span class="text-[10px] bg-red-500 text-white px-2.5 py-1 rounded-md font-black shadow-md animate-pulse uppercase tracking-widest">Pilne</span>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="flex-1 p-6 overflow-y-auto custom-scroll bg-slate-50">
        <!-- Fast Payment Action -->
        <div class="mb-8">
            {{ component('FastPaymentModalComponent', { size: 'lg' }) }}
        </div>

        <h5 class="text-[10px] font-bold uppercase text-[#6b7796] mb-4 tracking-widest">Wymagane Składki</h5>
        <div class="space-y-4 mb-6">
            {% for payment in unpaidPayments %}
                <div class="p-5 rounded-2xl border border-slate-200 bg-white shadow-sm relative overflow-hidden">
                    <div class="absolute left-0 top-0 bottom-0 w-1 bg-red-500"></div>
                    <div class="flex justify-between items-start mb-2">
                        <div>
                            <p class="font-bold text-sm text-[#1a2a52]">{{ payment.label }}</p>
                            <p class="text-[10px] font-bold text-red-500 mt-1 uppercase tracking-tighter">
                                {% if payment.dueAt %}
                                    Termin: {{ payment.dueAt|date('d.m.Y') }}
                                {% else %}
                                    Brak terminu
                                {% endif %}
                            </p>
                        </div>
                        <p class="font-bold text-red-500 text-lg">{{ payment.amount|money }}</p>
                    </div>
                </div>
            {% else %}
                <div class="text-center py-8 text-slate-400 italic">
                    Wszystkie składki opłacone! 🎉
                </div>
            {% endfor %}
        </div>
        
        {% if isTreasurer %}
            <!-- Treasurer Dashboard Link for Treasurer-Parents -->
            <a href="{{ path('treasurer_dashboard') }}" class="w-full bg-white text-[#1a2a52] border border-slate-200 shadow-sm py-4 rounded-2xl font-bold text-sm mb-4 flex justify-between items-center px-5 hover:bg-slate-50 transition-colors">
                <div class="flex items-center gap-3 text-blue-600">
                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
                    <span class="text-[#1a2a52]">Panel Skarbnika</span>
                </div>
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" class="text-slate-400"><path d="M9 18l6-6-6-6"/></svg>
            </a>
        {% endif %}

        <!-- Council Section Link -->
        <button class="w-full bg-white text-[#1a2a52] border border-slate-200 shadow-sm py-4 rounded-2xl font-bold text-sm mb-8 flex justify-between items-center px-5 hover:bg-slate-50 transition-colors">
            <div class="flex items-center gap-3 text-[#2aa57f]">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                <span class="text-[#1a2a52]">Budżet Klasy</span>
            </div>
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" class="text-slate-400"><path d="M9 18l6-6-6-6"/></svg>
        </button>
    </div>
</div>
{% endblock %}
