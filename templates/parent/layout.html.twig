{% extends 'base.html.twig' %}

{% block body %}
<div class="min-h-screen bg-slate-100 flex flex-col items-center justify-center p-0 md:p-6 lg:p-12">
    <!-- Main App Container (Centered phone-like on desktop, full on mobile) -->
    <div class="w-full max-w-[420px] bg-white md:rounded-[48px] overflow-hidden shadow-2xl md:border-[12px] md:border-[#15203d] flex flex-col h-screen md:h-[850px] md:max-h-[90vh] relative transition-all">
        
        <!-- Fixed Header Simulation for Profile consistency (optional, can be empty) -->
        {% block view_header %}{% endblock %}

        <!-- Content Area with scroll -->
        <div class="flex-1 overflow-y-auto custom-scroll bg-slate-50 flex flex-col">
            <div class="flex-1">
                {% block page_content %}{% endblock %}
            </div>
            
            <!-- Spacer for bottom nav to prevent overlap -->
            <div class="h-24 flex-shrink-0"></div>
        </div>

        <!-- Bottom Navigation -->
        <nav class="absolute bottom-0 inset-x-0 bg-white/90 backdrop-blur-xl border-t border-slate-100 flex justify-around items-center h-20 px-4 z-50">
            <a href="{{ path('homepage') }}" class="flex flex-col items-center gap-1 group">
                <div class="w-12 h-10 rounded-2xl flex items-center justify-center transition-all {% if app.request.attributes.get('_route') == 'homepage' or app.request.attributes.get('_route') == 'parent_dashboard' %}bg-[#1a2a52] text-[#e8b441] shadow-lg shadow-blue-900/20{% else %}text-slate-400 group-hover:bg-slate-50{% endif %}">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                </div>
                <span class="text-[10px] font-bold uppercase tracking-widest {% if app.request.attributes.get('_route') == 'homepage' or app.request.attributes.get('_route') == 'parent_dashboard' %}text-[#1a2a52]{% else %}text-slate-400{% endif %}">Start</span>
            </a>
            
            <a href="#" class="flex flex-col items-center gap-1 group opacity-40 cursor-not-allowed">
                <div class="w-12 h-10 rounded-2xl flex items-center justify-center transition-all text-slate-400 group-hover:bg-slate-50">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 12V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h7"/><path d="M16 19l2 2 4-4"/></svg>
                </div>
                <span class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Historia</span>
            </a>

            <a href="{{ path('profile') }}" class="flex flex-col items-center gap-1 group">
                <div class="w-12 h-10 rounded-2xl flex items-center justify-center transition-all {% if app.request.attributes.get('_route') == 'profile' %}bg-[#1a2a52] text-[#e8b441] shadow-lg shadow-blue-900/20{% else %}text-slate-400 group-hover:bg-slate-50{% endif %}">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </div>
                <span class="text-[10px] font-bold uppercase tracking-widest {% if app.request.attributes.get('_route') == 'profile' %}text-[#1a2a52]{% else %}text-slate-400{% endif %}">Profil</span>
            </a>
        </nav>
    </div>
</div>
{% endblock %}
