<header class="bg-white sticky top-0 z-40 w-full border-b border-border/60 bg-background/80 backdrop-blur-xl">
    <div class="container mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-6">
        {% set isClassPay = true %}
        <a class="flex items-center gap-2" href="{{ isClassPay ? path('homepage') : path('homepage') }}"
           title="{{ 'last_update'|trans }}{{ last_release()|format_date(pattern: 'HH:mm, dd MMM') }}">
            <div class="relative flex h-9 w-9 items-center justify-center rounded-lg bg-gradient-to-br from-indigo-500 to-purple-600 text-white shadow-md">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M3 21h18"/>
                    <path d="M5 21V10l7-5 7 5v11"/>
                    <path d="M10 21v-6h4v6"/>
                    <circle cx="12" cy="3" r="1" fill="currentColor"/>
                </svg>
            </div>
            <span class="text-xl font-bold text-foreground">{{ tenant_name() }}</span>
        </a>
        <nav class="flex items-center gap-6">
            {% if app.user %}
                <a href="{{ path('homepage') }}" class="text-sm font-medium text-foreground hover:text-primary transition-colors">Panel</a>
                {% if cc_is_treasurer() %}
                    <a href="{{ path('homepage') }}" class="text-sm font-medium text-foreground hover:text-primary transition-colors">Skarbnik</a>
                    <a href="{{ path('treasurer_students') }}" class="text-sm font-medium text-foreground hover:text-primary transition-colors">Uczniowie</a>
                    <a href="{{ path('treasurer_contributions') }}" class="text-sm font-medium text-foreground hover:text-primary transition-colors">Składki</a>
                {% endif %}
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('admin_settings') }}" class="text-sm font-medium text-foreground hover:text-primary transition-colors">Ustawienia</a>
                {% endif %}
            {% endif %}
        </nav>
        <div class="flex items-center gap-3">
            {% if app.user %}
            <!-- Notification Icon -->
            <button class="relative p-2 rounded-lg hover:bg-muted transition-colors">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                </svg>
                <span class="absolute top-1 right-1 h-2 w-2 bg-red-500 rounded-full"></span>
            </button>
            <!-- User Menu -->
            <div class="flex items-center gap-2 p-2 rounded-lg hover:bg-muted transition-colors cursor-pointer">
                <div class="h-8 w-8 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white text-sm font-semibold">
                    {{ app.user.email|first|upper }}
                </div>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M6 9l6 6 6-6"/>
                </svg>
            </div>
            {% endif %}
            <!-- Mobile menu button -->
            <button class="md:hidden p-2 rounded-lg hover:bg-muted transition-colors">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="3" x2="21" y1="12" y2="12"/>
                    <line x1="3" x2="21" y1="6" y2="6"/>
                    <line x1="3" x2="21" y1="18" y2="18"/>
                </svg>
            </button>
        </div>
    </div>
</header>