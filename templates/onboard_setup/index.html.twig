{% extends 'base.html.twig' %}

{% block title %}Konfiguracja Systemu - Classy Cash{% endblock %}

{% block stylesheets %}
    <style>
        :root {
            /* Brand Colors from Brand Book */
            --bg: #f7f6f0;               /* Noble Ivory */
            --fg: #15203d;               /* Deep Navy Text */
            --muted: #6b7796;            /* Steel Muted */
            --card: #ffffff;             /* Pure White */
            --border: #e2e6ee;
            --primary: #1a2a52;          /* Deep Navy */
            --primary-2: #2a4a7a;
            --secondary: #2aa57f;        /* Emerald Green */
            --secondary-soft: #e6f5ee;
            --accent: #e8b441;           /* Golden Amber */
            --danger: #d65a4a;
            --radius: 14px;
            --shadow-card: 0 4px 20px -6px rgba(26, 42, 82, 0.08);
            --gradient-hero: linear-gradient(135deg, #1a2a52 0%, #2a4a7a 50%, #2aa57f 100%);
        }

        /* Interactive Elements */
        .btn-primary { background-color: var(--primary); color: white; border-radius: var(--radius); padding: 12px 24px; font-weight: 600; transition: all 0.2s; text-align: center; }
        .btn-primary:hover { opacity: 0.9; transform: translateY(-1px); box-shadow: 0 4px 12px rgba(26, 42, 82, 0.15); }
        .btn-accent { background-color: var(--accent); color: var(--primary); border-radius: var(--radius); padding: 12px 24px; font-weight: 700; transition: all 0.2s; text-align: center; }
        .btn-accent:hover { filter: brightness(0.95); transform: translateY(-1px); box-shadow: 0 4px 15px rgba(232, 180, 65, 0.3); }
        .btn-outline { border: 1px solid var(--border); color: var(--fg); border-radius: var(--radius); padding: 10px 20px; font-weight: 600; transition: all 0.2s; background: white; }
        .btn-outline:hover { border-color: var(--primary); color: var(--primary); }

        /* Inputs & Cards */
        .input-elegant { background: white; border: 1px solid var(--border); border-radius: 10px; padding: 12px 16px; width: 100%; font-size: 0.95rem; outline: none; transition: border-color 0.2s; }
        .input-elegant:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(26, 42, 82, 0.05); }
        .card-elegant { background: var(--card); border-radius: var(--radius); border: 1px solid var(--border); box-shadow: var(--shadow-card); padding: 2rem; }

        /* Layout Utilities */
        .custom-scroll::-webkit-scrollbar { width: 6px; }
        .custom-scroll::-webkit-scrollbar-track { background: #f1f1f1; border-radius: 4px; }
        .custom-scroll::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
    </style>
{% endblock %}

{% block body %}

<div class="min-h-screen py-12 px-6 flex-col items-center">
    <div class="w-full max-w-3xl">
        <header class="text-center mb-12">
            <svg width="64" height="64" viewBox="0 0 100 100" class="mx-auto mb-6 shadow-xl rounded-2xl">
                <rect width="100" height="100" rx="24" fill="#1a2a52" />
                <path d="M50 15L80 35V65L50 85L20 65V35L50 15Z" stroke="#e8b441" stroke-width="4" fill="none" />
                <circle cx="50" cy="50" r="15" stroke="#e8b441" stroke-width="4" fill="none" />
                <path d="M50 35V65M42 42H58M42 58H58" stroke="#e8b441" stroke-width="4" stroke-linecap="round" fill="none" />
            </svg>
            <h1 class="text-3xl md:text-4xl font-serif-brand font-bold text-[#1a2a52] mb-4">Konfiguracja Systemu</h1>
            <p class="text-[#6b7796]">Skonfiguruj finanse Twojej klasy w 3 prostych krokach.</p>
        </header>

        {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
            <!-- Krok 1 -->
            <div class="card-elegant relative overflow-hidden">
                <div class="absolute left-0 top-0 bottom-0 w-1 bg-[#1a2a52]"></div>
                <h3 class="text-lg font-bold mb-6 flex items-center gap-3">
                    <span class="w-6 h-6 rounded-full bg-[#1a2a52] text-[#e8b441] flex items-center justify-center text-[10px]">1</span>
                    Informacje o klasie
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        {{ form_label(form.className, null, {'label_attr': {'class': 'block text-[10px] font-bold uppercase mb-2'}}) }}
                        {{ form_widget(form.className, {'attr': {'class': 'input-elegant', 'placeholder': '4B'}}) }}
                        {{ form_errors(form.className) }}
                    </div>
                    <div>
                        {{ form_label(form.schoolName, null, {'label_attr': {'class': 'block text-[10px] font-bold uppercase mb-2'}}) }}
                        {{ form_widget(form.schoolName, {'attr': {'class': 'input-elegant', 'placeholder': 'Szkoła Podstawowa nr 5'}}) }}
                        {{ form_errors(form.schoolName) }}
                    </div>
                </div>
            </div>

            <!-- Krok 2 -->
            <div class="card-elegant relative overflow-hidden">
                <div class="absolute left-0 top-0 bottom-0 w-1 bg-[#1a2a52]"></div>
                <h3 class="text-lg font-bold mb-6 flex items-center gap-3">
                    <span class="w-6 h-6 rounded-full bg-[#1a2a52] text-[#e8b441] flex items-center justify-center text-[10px]">2</span>
                    Dane do przelewów
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        {{ form_label(form.blikPhone, null, {'label_attr': {'class': 'block text-[10px] font-bold uppercase mb-2'}}) }}
                        {{ form_widget(form.blikPhone, {'attr': {'class': 'input-elegant', 'placeholder': '123456789'}}) }}
                        {{ form_errors(form.blikPhone) }}
                    </div>
                    <div>
                        {{ form_label(form.bankAccount, null, {'label_attr': {'class': 'block text-[10px] font-bold uppercase mb-2'}}) }}
                        {{ form_widget(form.bankAccount, {'attr': {'class': 'input-elegant', 'placeholder': 'PL 00 0000...'}}) }}
                        {{ form_errors(form.bankAccount) }}
                    </div>
                </div>
            </div>

            <!-- Krok 3 -->
            <div class="card-elegant relative overflow-hidden bg-amber-50/40 border-amber-200">
                <div class="absolute left-0 top-0 bottom-0 w-1 bg-[#e8b441]"></div>
                <h3 class="text-lg font-bold mb-2 flex items-center gap-3">
                    <span class="w-6 h-6 rounded-full bg-[#e8b441] text-[#1a2a52] flex items-center justify-center text-[10px]">3</span>
                    Automatyzacja wpłat (Alior Bank)
                </h3>
                <p class="text-xs text-[#6b7796] mb-6 max-w-xl">System automatycznie zaksięguje przelewy na podstawie powiadomień e-mail. Aktualnie wspieramy połączenie Alior Bank z kontem Gmail.</p>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        {{ form_label(form.email, null, {'label_attr': {'class': 'block text-[10px] font-bold uppercase mb-2'}}) }}
                        {{ form_widget(form.email, {'attr': {'class': 'input-elegant bg-white border-amber-200 focus:border-[#e8b441]', 'placeholder': 'twoja.klasa@gmail.com'}}) }}
                        {{ form_errors(form.email) }}
                    </div>
                    <div>
                        {{ form_label(form.appPassword, null, {'label_attr': {'class': 'block text-[10px] font-bold uppercase mb-2'}}) }}
                        {{ form_widget(form.appPassword, {'attr': {'class': 'input-elegant bg-white border-amber-200 focus:border-[#e8b441]', 'placeholder': '16-znakowe hasło'}}) }}
                        {{ form_errors(form.appPassword) }}
                    </div>
                </div>
            </div>

            <div class="flex justify-between items-center pt-8">
                <a href="{{ path('app_login') }}" class="text-sm font-bold text-[#6b7796] hover:text-[#1a2a52]">Wróć do logowania</a>
                {{ form_widget(form.submit, {'attr': {'class': 'btn-accent px-12 py-4 text-lg shadow-xl shadow-amber-200/50'}}) }}
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
