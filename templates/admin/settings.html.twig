{% extends 'base.html.twig' %}

{% block title %}{{ 'admin.settings.title'|trans }}{% endblock %}

{% block body %}
    <main class="flex-grow container mx-auto px-4 py-8 flex justify-center">
        <div class="max-w-md w-full text-center">
            <div class="mb-8 flex justify-center">
                <div class="bg-secondary/10 p-6 rounded-full ring-8 ring-secondary/5">
                    <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-secondary">
                        <path d="M3 9h18v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9Z"/>
                        <path d="M3 9V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v4"/>
                        <path d="M13 13h4"/>
                        <path d="M13 17h4"/>
                        <path d="M7 13h2v4H7z"/>
                    </svg>
                </div>
            </div>
            <h1 class="text-3xl font-display font-bold text-primary mb-3">{{ 'admin.settings.title'|trans }}</h1>
            <p class="text-muted-foreground text-lg mb-8 leading-relaxed">{{ 'admin.settings.description'|trans }}</p>

            {% for flash in app.flashes('success') %}
                <div class="bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-md mb-6">
                    {{ flash }}
                </div>
            {% endfor %}

            <div class="card-dark p-6 space-y-6 max-w-2xl text-left">
                {% include 'treasurer/_settings_form.html.twig' with { form: form } %}
            </div>

            <div class="mt-8 text-center">
                <a href="{{ path('homepage') }}" class="text-primary hover:text-primary/80 text-sm">
                    {{ 'admin.settings.back_to_app'|trans }}
                </a>
            </div>
        </div>
    </main>
{% endblock %}
