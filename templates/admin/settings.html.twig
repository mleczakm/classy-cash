{% extends 'base.html.twig' %}

{% block title %}{{ 'admin.settings.title'|trans }}{% endblock %}

{% block body %}
    <main class="flex-grow">
        <div class="page-container">
            <div class="max-w-2xl mx-auto">
                <div class="mb-8">
                    <h1 class="section-title">{{ 'admin.settings.title'|trans }}</h1>
                    <p class="text-muted-foreground mt-2">{{ 'admin.settings.description'|trans }}</p>
                </div>

                {% for flash in app.flashes('success') %}
                    <div class="bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-md mb-6">
                        {{ flash }}
                    </div>
                {% endfor %}

                <div class="bg-white shadow-sm border rounded-lg">
                    <form method="post" class="p-6 space-y-6">
                        <div>
                            <label for="app_name" class="block text-sm font-medium text-gray-700 mb-2">
                                {{ 'admin.settings.app_name.label'|trans }}
                            </label>
                            <input 
                                type="text" 
                                id="app_name" 
                                name="app_name" 
                                value="{{ app_name }}"
                                class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                placeholder="Classy Cash"
                            >
                            <p class="text-sm text-gray-500 mt-1">{{ 'admin.settings.app_name.help'|trans }}</p>
                        </div>

                        <div>
                            <label for="email_from" class="block text-sm font-medium text-gray-700 mb-2">
                                {{ 'admin.settings.email_from.label'|trans }}
                            </label>
                            <input 
                                type="email" 
                                id="email_from" 
                                name="email_from" 
                                value="{{ email_from }}"
                                class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                placeholder="noreply@classy-cash.com"
                            >
                            <p class="text-sm text-gray-500 mt-1">{{ 'admin.settings.email_from.help'|trans }}</p>
                        </div>

                        <div>
                            <label for="blik_phone" class="block text-sm font-medium text-gray-700 mb-2">
                                {{ 'admin.settings.blik_phone.label'|trans }}
                            </label>
                            <input 
                                type="tel" 
                                id="blik_phone" 
                                name="blik_phone" 
                                value="{{ blik_phone }}"
                                class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                placeholder="+48 123 456 789"
                            >
                            <p class="text-sm text-gray-500 mt-1">{{ 'admin.settings.blik_phone.help'|trans }}</p>
                        </div>

                        <div>
                            <label for="transfer_account" class="block text-sm font-medium text-gray-700 mb-2">
                                {{ 'admin.settings.transfer_account.label'|trans }}
                            </label>
                            <input 
                                type="text" 
                                id="transfer_account" 
                                name="transfer_account" 
                                value="{{ transfer_account }}"
                                class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                placeholder="PL 12 3456 7890 1234 5678 9012 3456"
                            >
                            <p class="text-sm text-gray-500 mt-1">{{ 'admin.settings.transfer_account.help'|trans }}</p>
                        </div>

                        <div class="pt-4">
                            <button 
                                type="submit" 
                                class="w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors"
                            >
                                {{ 'admin.settings.save_button'|trans }}
                            </button>
                        </div>
                    </form>
                </div>

                <div class="mt-8 text-center">
                    <a href="{{ path('homepage') }}" class="text-blue-600 hover:text-blue-800 text-sm">
                        {{ 'admin.settings.back_to_app'|trans }}
                    </a>
                </div>
            </div>
        </div>
    </main>
{% endblock %}
