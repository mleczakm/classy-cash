{% extends 'base.html.twig' %}

{% block body %}
    <main class="flex-grow">
        {% if app.user and classRoom is defined and classRoom %}
            <div class="container">
                <!-- Hero Section for logged-in user -->
                <section class="hero mt-8">
                    <div class="eyebrow">Witaj z powrotem!</div>
                    <h1>Rada Klasowa</h1>
                    <p>Twoja klasa: <strong>{{ classRoom.name }}</strong></p>
                    <div class="actions">
                        <a href="{{ path('cc_dashboard') }}" class="btn btn-primary">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                            </svg>
                            Panel klasy
                        </a>
                    </div>
                </section>

                <!-- Payment Information Card -->
                <div class="grid-2" style="margin-top: 28px;">
                    <div class="card">
                        <div class="card-header">
                            <h2>Płatności</h2>
                        </div>
                        <div class="card-body">
                            <div style="margin-bottom: 20px;">
                                <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 12px;">
                                    <div style="width: 40px; height: 40px; border-radius: 12px; background: var(--secondary-soft); display: flex; align-items: center; justify-content: center; color: var(--secondary);">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/>
                                            <line x1="1" y1="10" x2="23" y2="10"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <div style="font-weight: 600; margin-bottom: 4px;">BLIK</div>
                                        <div style="color: var(--primary); font-weight: 600;">{{ tenant_phone() ?? ('blik.phone'|trans) }}</div>
                                    </div>
                                </div>
                            </div>
                            
                            <div style="margin-bottom: 24px;">
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <div style="width: 40px; height: 40px; border-radius: 12px; background: var(--secondary-soft); display: flex; align-items: center; justify-content: center; color: var(--secondary);">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                            <circle cx="8.5" cy="7" r="4"/>
                                            <line x1="20" y1="8" x2="20" y2="14"/>
                                            <line x1="23" y1="11" x2="17" y2="11"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <div style="font-weight: 600; margin-bottom: 4px;">Przelew bankowy</div>
                                        <div style="color: var(--primary); font-weight: 600; font-size: 14px;">{{ tenant_account() ?? '46 2490 0005 0000 4000 1897 5420' }}</div>
                                    </div>
                                </div>
                            </div>

                            <a href="{{ path('cc_dashboard') }}" class="btn btn-primary btn-block">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                    <circle cx="12" cy="12" r="3"/>
                                </svg>
                                Zobacz panel klasy
                            </a>
                        </div>
                    </div>

                    <!-- Quick Stats -->
                    <div class="card">
                        <div class="card-header">
                            <h2>Szybkie info</h2>
                        </div>
                        <div class="card-body">
                            <div class="list">
                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                    <span style="color: var(--muted);">Status konta</span>
                                    <span class="badge badge-success">Aktywne</span>
                                </div>
                            </div>
                            <div class="list">
                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                    <span style="color: var(--muted);">Rola</span>
                                    <span style="font-weight: 600;">Członek rady</span>
                                </div>
                            </div>
                            <div class="list">
                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                    <span style="color: var(--muted);">Klasa</span>
                                    <span style="font-weight: 600;">{{ classRoom.name }}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <!-- Hero Section for non-logged-in user -->
            <section class="hero mt-8">
                <div class="eyebrow">Witaj w</div>
                <h1>Rada Klasowa</h1>
                <p>Przejrzysty rejestr wpłat i wydatków klasowych. Zaloguj się aby zobaczyć obowiązki i historię płatności.</p>
                <div class="actions">
                    <a href="{{ path('app_login') }}" class="btn btn-primary">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                            <polyline points="10 17 15 12 10 7"/>
                            <line x1="15" y1="12" x2="3" y2="12"/>
                        </svg>
                        Zaloguj
                    </a>
                    <a href="{{ path('user_register') }}" class="btn btn-outline">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                            <circle cx="8.5" cy="7" r="4"/>
                            <line x1="20" y1="8" x2="20" y2="14"/>
                            <line x1="23" y1="11" x2="17" y2="11"/>
                        </svg>
                        Zarejestruj
                    </a>
                </div>
            </section>

            <!-- Features Section -->
            <div class="container">
                <div class="grid-2" style="margin-top: 28px;">
                    <div class="card">
                        <div class="card-header">
                            <h2>📊 Przejrzystość</h2>
                        </div>
                        <div class="card-body">
                            <p style="color: var(--muted); margin-bottom: 16px;">
                                Śledź wszystkie wpłaty i wydatki w czasie rzeczywistym. Każda transakcja jest dokładnie udokumentowana.
                            </p>
                            <ul class="list">
                                <li style="padding: 8px 0; border-bottom: 1px solid var(--border);">
                                    <span style="color: var(--secondary);">✓</span> Historia transakcji
                                </li>
                                <li style="padding: 8px 0; border-bottom: 1px solid var(--border);">
                                    <span style="color: var(--secondary);">✓</span> Automatyczne powiadomienia
                                </li>
                                <li style="padding: 8px 0;">
                                    <span style="color: var(--secondary);">✓</span> Generowanie raportów
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <h2>💳 Łatwe płatności</h2>
                        </div>
                        <div class="card-body">
                            <p style="color: var(--muted); margin-bottom: 16px;">
                                Wiele sposobów na dokonanie wpłaty - BLIK, przelew bankowy, czy płatności online.
                            </p>
                            <ul class="list">
                                <li style="padding: 8px 0; border-bottom: 1px solid var(--border);">
                                    <span style="color: var(--secondary);">✓</span> Szybkie płatności BLIK
                                </li>
                                <li style="padding: 8px 0; border-bottom: 1px solid var(--border);">
                                    <span style="color: var(--secondary);">✓</span> Przelewy tradycyjne
                                </li>
                                <li style="padding: 8px 0;">
                                    <span style="color: var(--secondary);">✓</span> Automatyczne potwierdzenia
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
    </main>
{% endblock %}
