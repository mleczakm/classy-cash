{% extends 'treasurer/layout.html.twig' %}

{% block title %}Przypisz Przelew{% endblock %}

{% block page_content %}
<div class="t-view">
    <header class="mb-10">
        <h1 class="text-3xl font-serif-brand font-bold text-[#1a2a52]">Przypisz Przelew</h1>
        <p class="text-[#6b7796]">Wybierz płatność ucznia, do której chcesz przypisać ten przelew.</p>
    </header>

    <div class="card-elegant p-6 border border-slate-200 mb-6">
        <div class="bg-slate-50 p-4 rounded-lg border border-slate-200 mb-6">
            <h2 class="font-bold text-[#1a2a52] mb-2">Szczegóły przelewu</h2>
            <div class="grid grid-cols-2 gap-4 text-sm">
                <div>
                    <span class="text-slate-500">Tytuł:</span>
                    <div class="font-mono text-xs font-bold text-[#1a2a52]">{{ transfer.title }}</div>
                </div>
                <div>
                    <span class="text-slate-500">Nadawca:</span>
                    <div class="text-[#1a2a52]">{{ transfer.sender }}</div>
                </div>
                <div>
                    <span class="text-slate-500">Kwota:</span>
                    <div class="font-bold text-[#1a2a52]">{{ transfer.amount }}</div>
                </div>
                <div>
                    <span class="text-slate-500">Data:</span>
                    <div class="text-[#1a2a52]">{{ transfer.transferredAt|date('d.m.Y H:i') }}</div>
                </div>
            </div>
        </div>

        <form method="post" class="space-y-4">
            <div>
                <label class="block text-sm font-bold text-[#1a2a52] mb-2">Wybierz płatność do przypisania</label>
                <select name="student_payment_id" class="w-full p-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-[#e8b441] focus:border-transparent">
                    <option value="">-- Wybierz płatność --</option>
                    {% for payment in pendingPayments %}
                        <option value="{{ payment.id }}">
                            {{ payment.student.firstName }} {{ payment.student.lastName }} - {{ payment.title }} ({{ payment.amount }})
                            {% if payment.dueAt %} - Termin: {{ payment.dueAt|date('d.m.Y') }}{% endif %}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div class="flex gap-4">
                <button type="submit" class="px-6 py-3 bg-[#1a2a52] text-white font-bold rounded-lg hover:bg-[#2a3a62] transition-colors">
                    Przypisz przelew
                </button>
                <a href="{{ path('treasurer_payments') }}" class="px-6 py-3 bg-slate-200 text-slate-700 font-bold rounded-lg hover:bg-slate-300 transition-colors">
                    Anuluj
                </a>
            </div>
        </form>
    </div>
</div>
{% endblock %}
