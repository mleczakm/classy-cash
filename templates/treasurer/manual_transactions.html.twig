{% extends 'treasurer/layout.html.twig' %}

{% block title %}Kasa Ręczna{% endblock %}

{% block content %}
<div class="t-view">
    <header class="mb-10">
        <h1 class="text-3xl font-serif-brand font-bold text-[#1a2a52]">Kasa Ręczna</h1>
        <p class="text-[#6b7796]">Zaksięguj gotówkę od rodzica lub wpisz wydatek z kasy klasowej.</p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Form: Przychód -->
        <div class="card-elegant border-t-4 border-t-[#2aa57f] bg-white">
            <h3 class="font-bold text-[#1a2a52] text-lg mb-6 flex items-center gap-2">
                <svg width="20" height="20" fill="none" stroke="#2aa57f" stroke-width="3">
                    <path d="M12 19V5M5 12l7-7 7 7"/>
                </svg>
                Wpłata (Gotówka)
            </h3>
            <form method="post" class="space-y-4">
                <input type="hidden" name="transaction_type" value="income">
                
                <div>
                    <label class="block text-[10px] font-bold uppercase mb-2 text-[#6b7796]">Kwota (PLN)</label>
                    <input type="number" name="amount_pln" step="0.01" class="input-elegant bg-slate-50 text-xl font-bold font-serif-brand" placeholder="0.00" required>
                </div>
                <div>
                    <label class="block text-[10px] font-bold uppercase mb-2 text-[#6b7796]">Przypisz do ucznia / składki</label>
                    <select name="student_payment_id" class="input-elegant bg-slate-50">
                        <option value="">Brak (Wpłata ogólna)</option>
                        {% for payment in studentPayments %}
                            <option value="{{ payment.id }}">
                                {{ payment.student.firstName }} {{ payment.student.lastName }} ({{ payment.label }})
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <button type="submit" class="w-full btn-primary !bg-[#2aa57f] mt-4 shadow-lg shadow-emerald-200">
                    Zaksięguj Przychód
                </button>
            </form>
        </div>

        <!-- Form: Wydatek -->
        <div class="card-elegant border-t-4 border-t-[#d65a4a] bg-white">
            <h3 class="font-bold text-[#1a2a52] text-lg mb-6 flex items-center gap-2">
                <svg width="20" height="20" fill="none" stroke="#d65a4a" stroke-width="3">
                    <path d="M12 5v14M5 12l7 7 7-7"/>
                </svg>
                Koszty / Wypłata
            </h3>
            <form method="post" class="space-y-4">
                <input type="hidden" name="transaction_type" value="expense">
                
                <div>
                    <label class="block text-[10px] font-bold uppercase mb-2 text-[#6b7796]">Kwota wydana (PLN)</label>
                    <input type="number" name="amount_pln" step="0.01" class="input-elegant bg-slate-50 text-xl font-bold font-serif-brand" placeholder="0.00" required>
                </div>
                <div>
                    <label class="block text-[10px] font-bold uppercase mb-2 text-[#6b7796]">Opis / Przeznaczenie</label>
                    <input type="text" name="expense_description" class="input-elegant bg-slate-50" placeholder="np. Bilety wstępu, Tort dla wychowawcy" required>
                </div>
                <button type="submit" class="w-full btn-primary !bg-[#d65a4a] mt-4 shadow-lg shadow-red-200">
                    Zaksięguj Wydatek
                </button>
            </form>
        </div>
    </div>
</div>
{% endblock %}
