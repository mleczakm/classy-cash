{% extends 'base.html.twig' %}

{% block title %}Classy Cash — Panel Skarbnika{% endblock %}

{% block body %}
    <div class="min-h-screen lg:pl-64 flex-col bg-slate-50/50">
        {% include 'treasurer/_menu.html.twig' %}
        <!-- Main Content Area -->
        <main class="flex-1 p-4 md:p-8 max-w-7xl mx-auto w-full">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : label }} mb-4 p-4 rounded-lg {{ label == 'error' ? 'bg-red-50 text-red-700 border border-red-200' : 'bg-emerald-50 text-emerald-700 border border-emerald-100' }}">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            {% block page_content %}{% endblock %}
        </main>
    </div>
    <!-- Treasurer Navigation -->
    {% include 'treasurer/_menu.html.twig' %}
{% endblock %}
