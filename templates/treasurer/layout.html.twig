{# templates/treasurer/layout.html.twig #}
{# Main layout for Treasurer Dashboard pages #}

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Classy Cash — Panel Skarbnika{% endblock %}</title>

    <!-- Fonts: Inter for UI, Playfair Display for branding -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,700;1,700&display=swap" rel="stylesheet">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        :root {
            /* Brand Colors from Brand Book */
            --bg: #f7f6f0;               /* Noble Ivory */
            --fg: #15203d;               /* Deep Navy Text */
            --muted: #6b7796;            /* Steel Muted */
            --card: #ffffff;             /* Pure White */
            --border: #e2e6ee;
            --primary: #1a2a52;          /* Deep Navy */
            --primary-2: #2a4a7a;
            --secondary: #2aa57f;        /* Emerald Green */
            --secondary-soft: #e6f5ee;
            --accent: #e8b441;           /* Golden Amber */
            --danger: #d65a4a;
            --radius: 14px;
            --shadow-card: 0 4px 20px -6px rgba(26, 42, 82, 0.08);
            --gradient-hero: linear-gradient(135deg, #1a2a52 0%, #2a4a7a 50%, #2aa57f 100%);
        }

        body { background-color: var(--bg); color: var(--fg); font-family: 'Inter', sans-serif; }
        .font-serif-brand { font-family: 'Playfair Display', serif; }

        /* Interactive Elements */
        .btn-primary { background-color: var(--primary); color: white; border-radius: var(--radius); padding: 12px 24px; font-weight: 600; transition: all 0.2s; text-align: center; }
        .btn-primary:hover { opacity: 0.9; transform: translateY(-1px); box-shadow: 0 4px 12px rgba(26, 42, 82, 0.15); }
        .btn-accent { background-color: var(--accent); color: var(--primary); border-radius: var(--radius); padding: 12px 24px; font-weight: 700; transition: all 0.2s; text-align: center; }
        .btn-accent:hover { filter: brightness(0.95); transform: translateY(-1px); box-shadow: 0 4px 15px rgba(232, 180, 65, 0.3); }
        .btn-outline { border: 1px solid var(--border); color: var(--fg); border-radius: var(--radius); padding: 10px 20px; font-weight: 600; transition: all 0.2s; background: white; }
        .btn-outline:hover { border-color: var(--primary); color: var(--primary); }

        /* Inputs & Cards */
        .input-elegant { background: white; border: 1px solid var(--border); border-radius: 10px; padding: 12px 16px; width: 100%; font-size: 0.95rem; outline: none; transition: border-color 0.2s; }
        .input-elegant:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(26, 42, 82, 0.05); }
        .card-elegant { background: var(--card); border-radius: var(--radius); border: 1px solid var(--border); box-shadow: var(--shadow-card); padding: 2rem; }

        /* Status Badges */
        .status-badge { padding: 4px 12px; border-radius: 99px; font-size: 0.7rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; display: inline-block; }

        /* Layout Utilities */
        .custom-scroll::-webkit-scrollbar { width: 6px; }
        .custom-scroll::-webkit-scrollbar-track { background: #f1f1f1; border-radius: 4px; }
        .custom-scroll::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
    </style>

    {% block stylesheets %}{% endblock %}
</head>
<body class="antialiased selection:bg-[#e8b441]/30 selection:text-[#1a2a52]">

<div class="min-h-screen lg:pl-64 flex-col bg-slate-50/50">
    {% include 'treasurer/_menu.html.twig' %}

    <!-- Topbar Mobile -->
    <header class="bg-white border-b border-[#e2e6ee] px-6 py-4 flex items-center justify-between lg:hidden sticky top-0 z-30 shadow-sm">
        <div class="flex items-center gap-2">
            <svg width="32" height="32" viewBox="0 0 100 100" class="rounded-lg">
                <rect width="100" height="100" rx="24" fill="#1a2a52" />
                <path d="M50 15L80 35V65L50 85L20 65V35L50 15Z" stroke="#e8b441" stroke-width="4" fill="none" />
                <circle cx="50" cy="50" r="15" stroke="#e8b441" stroke-width="4" fill="none" />
                <path d="M50 35V65M42 42H58M42 58H58" stroke="#e8b441" stroke-width="4" stroke-linecap="round" fill="none" />
            </svg>
            <span class="font-serif-brand font-bold text-[#1a2a52] text-lg">Classy Cash</span>
        </div>
        <button onclick="toggleSidebar()" class="p-2 text-[#1a2a52] bg-slate-50 rounded-lg">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
        </button>
    </header>

    <!-- Main Content Area -->
    <main class="flex-1 p-4 md:p-8 max-w-7xl mx-auto w-full">
        {% block content %}{% endblock %}
    </main>
</div>

<!-- Scripts -->
<script>
    // Sidebar Toggle logic
    function toggleSidebar() {
        const sb = document.getElementById('sidebar');
        const ov = document.getElementById('sidebar-overlay');
        if(sb.classList.contains('-translate-x-full')) {
            sb.classList.remove('-translate-x-full');
            ov.classList.remove('hidden');
        } else {
            closeSidebar();
        }
    }

    function closeSidebar() {
        document.getElementById('sidebar').classList.add('-translate-x-full');
        document.getElementById('sidebar-overlay').classList.add('hidden');
    }
</script>

{% block javascripts %}{% endblock %}
</body>
</html>
