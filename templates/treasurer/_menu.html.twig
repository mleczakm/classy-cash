{# templates/treasurer/_menu.html.twig #}
{# Sidebar Navigation for Treasurer Dashboard #}

<aside id="sidebar" class="fixed inset-y-0 left-0 z-50 w-64 bg-white border-r border-[#e2e6ee] transform -translate-x-full lg:translate-x-0 transition-transform duration-300 flex flex-col shadow-[4px_0_24px_rgba(0,0,0,0.02)]">
    <div class="p-6">
        <div class="flex items-center gap-3 mb-10">
            <svg width="40" height="40" viewBox="0 0 100 100" class="rounded-xl shadow-sm">
                <rect width="100" height="100" rx="24" fill="#1a2a52" />
                <path d="M50 15L80 35V65L50 85L20 65V35L50 15Z" stroke="#e8b441" stroke-width="4" fill="none" />
                <circle cx="50" cy="50" r="15" stroke="#e8b441" stroke-width="4" fill="none" />
                <path d="M50 35V65M42 42H58M42 58H58" stroke="#e8b441" stroke-width="4" stroke-linecap="round" fill="none" />
            </svg>
            <span class="text-xl font-serif-brand font-bold text-[#1a2a52]">Classy Cash</span>
        </div>

        <nav class="space-y-2">
            <a href="{{ path('treasurer_dashboard') }}"
               class="sidebar-link w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold transition-colors {{ app.request.attributes.get('_route') == 'treasurer_dashboard' ? 'bg-slate-100 text-[#1a2a52]' : 'text-[#6b7796] hover:bg-slate-50 hover:text-[#1a2a52]' }}">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                    <rect width="18" height="18" x="3" y="3" rx="2"/>
                    <path d="M3 9h18M9 21V9"/>
                </svg>
                Dashboard
            </a>

            <a href="{{ path('parent_dashboard') }}"
               class="sidebar-link w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold transition-colors text-emerald-600 hover:bg-emerald-50">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                Mój widok rodzica
            </a>
            
            <div class="pt-4 pb-2 text-[10px] font-bold uppercase tracking-widest text-slate-400 px-4">Zarządzanie</div>

            <a href="{{ path('treasurer_payments') }}" 
               class="sidebar-link w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold transition-colors {{ app.request.attributes.get('_route') == 'treasurer_payments' ? 'bg-slate-100 text-[#1a2a52]' : 'text-[#6b7796] hover:bg-slate-50 hover:text-[#1a2a52]' }}">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 1v22m5-18H7a3 3 0 000 6h10a3 3 0 010 6H7"/>
                </svg>
                Operacje Bankowe
            </a>
            
            <a href="{{ path('treasurer_contributions') }}" 
               class="sidebar-link w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold transition-colors {{ app.request.attributes.get('_route') == 'treasurer_contributions' ? 'bg-slate-100 text-[#1a2a52]' : 'text-[#6b7796] hover:bg-slate-50 hover:text-[#1a2a52]' }}">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 00 2 2h12a2 2 0 00 2-2V8z"/>
                    <path d="M12 18v-6M9 15h6"/>
                </svg>
                Zarządzaj Składkami
            </a>
            
            <a href="{{ path('treasurer_students') }}" 
               class="sidebar-link w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold transition-colors {{ app.request.attributes.get('_route') == 'treasurer_students' ? 'bg-slate-100 text-[#1a2a52]' : 'text-[#6b7796] hover:bg-slate-50 hover:text-[#1a2a52]' }}">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M23 21v-2a4 4 0 00-3-3.87m-4-12a4 4 0 010 7.75"/>
                </svg>
                Uczniowie i Rodzice
            </a>
            
            <a href="{{ path('treasurer_manual_transactions') }}" 
               class="sidebar-link w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold transition-colors {{ app.request.attributes.get('_route') == 'treasurer_manual_transactions' ? 'bg-slate-100 text-[#1a2a52]' : 'text-[#6b7796] hover:bg-slate-50 hover:text-[#1a2a52]' }}">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 5v14M5 12h14"/>
                </svg>
                Kasa Ręczna
            </a>
        </nav>
    </div>

    <div class="mt-auto p-6 border-t border-[#e2e6ee] bg-slate-50/50">
        <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-full bg-[#1a2a52] text-[#e8b441] flex items-center justify-center font-bold">
                {{ app.user.email|first|upper }}
            </div>
            <div>
                <p class="text-sm font-bold text-[#1a2a52]">{{ app.user.email }}</p>
                <p class="text-[10px] font-bold uppercase text-[#6b7796]">Skarbnik</p>
            </div>
        </div>
        <a href="{{ path('app_logout') }}" class="text-xs font-bold text-red-500 hover:text-red-700 transition-colors uppercase tracking-widest">
            Wyloguj się
        </a>
    </div>
</aside>

<!-- Overlay Mobile -->
<div id="sidebar-overlay" class="fixed inset-0 bg-[#1a2a52]/40 z-40 hidden lg:hidden backdrop-blur-sm transition-opacity" onclick="toggleSidebar()"></div>
