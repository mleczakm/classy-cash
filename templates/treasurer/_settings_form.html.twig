{% form_theme form 'treasurer/_settings_form_theme.html.twig' %}

{{ form_start(form, { attr: { class: 'space-y-6' } }) }}
    {{ form_row(form.appName) }}
    {{ form_row(form.schoolName) }}
    {{ form_row(form.emailFrom) }}
    {{ form_row(form.blikPhone) }}
    {{ form_row(form.transferAccount) }}
    {{ form_row(form.parentRegistrationEnabled) }}
    <div class="pt-2">
        {{ form_widget(form.save) }}
    </div>
{{ form_end(form) }}
