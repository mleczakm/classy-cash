{# templates/treasurer/components/dashboard/recent_payments.html.twig #}
{# Recent Payments Live Component Template #}

<table class="w-full text-left whitespace-nowrap">
    <tbody class="divide-y divide-slate-50 text-sm">
        {% for payment in recentPayments %}
            <tr>
                <td class="px-6 py-4">
                    <div class="font-bold text-[#1a2a52]">{{ payment.student.firstName }} {{ payment.student.lastName }}</div>
                    <div class="text-[10px] text-[#6b7796]">Składka: {{ payment.label }}</div>
                </td>
                <td class="px-6 py-4 font-bold text-[#2aa57f]">
                    +{{ formatAmount(payment.amount) }}
                </td>
                <td class="px-6 py-4">
                    <span class="status-badge {{ getPaymentMethodClass(payment) }}">
                        {{ getPaymentMethod(payment) }}
                    </span>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3" class="px-6 py-8 text-center text-[#6b7796]">
                    Brak ostatnich płatności
                </td>
            </tr>
        {% endfor %}
    </tbody>
</table>
