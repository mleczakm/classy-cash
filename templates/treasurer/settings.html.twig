{% extends 'treasurer/layout.html.twig' %}

{% block title %}{{ 'admin.settings.title'|trans }}{% endblock %}

{% block page_content %}
<div class="t-view">
    <header class="mb-10">
        <h1 class="text-3xl font-serif-brand font-bold text-[#1a2a52]">{{ 'admin.settings.title'|trans }}</h1>
        <p class="text-[#6b7796]">{{ 'admin.settings.description'|trans }}</p>
    </header>

    <div class="card-elegant bg-white shadow-md border border-slate-200 p-6 md:p-8 max-w-2xl">
        {% include 'treasurer/_settings_form.html.twig' with { form: form } %}
    </div>
</div>
{% endblock %}
