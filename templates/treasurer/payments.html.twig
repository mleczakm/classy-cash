{% extends 'treasurer/layout.html.twig' %}

{% block title %}Operacje Bankowe{% endblock %}

{% block page_content %}
<div class="t-view">
    <header class="mb-10">
        <h1 class="text-3xl font-serif-brand font-bold text-[#1a2a52]">Lista Operacji Bankowych</h1>
        <p class="text-[#6b7796]">Przegląd zaksięgowanych przelewów i obsługa błędnych tytułów.</p>
    </header>

    <div class="card-elegant !p-0 overflow-hidden border border-slate-200">
        <div class="overflow-x-auto bg-white">
            <table class="w-full text-left">
                <thead class="bg-slate-50 border-b text-[10px] uppercase font-bold text-slate-500 tracking-wider">
                    <tr>
                        <th class="px-6 py-4">Tytuł przelewu / Nadawca</th>
                        <th class="px-6 py-4">Status / Cel</th>
                        <th class="px-6 py-4">Kwota</th>
                        <th class="px-6 py-4 text-right">Akcja</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-sm">
                    {% for transfer in transfers %}
                        {% set payment = transfer.payment %}
                        {% set isMatched = payment is not null %}
                        {% set isPartial = isMatched and not payment.amountMatch(transfer) %}
                        
                        <tr class="{% if not isMatched %}bg-red-50/60{% elseif isPartial %}bg-orange-50/40{% else %}hover:bg-slate-50{% endif %} transition-colors">
                            <td class="px-6 py-4">
                                <div class="font-bold {% if not isMatched %}text-red-700 italic{% else %}text-[#1a2a52]{% endif %} font-mono text-xs">
                                    {{ transfer.title }}
                                </div>
                                <div class="text-[10px] {% if not isMatched %}text-slate-500{% else %}text-slate-400{% endif %}">
                                    Nadawca: {{ transfer.sender }}
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                {% if not isMatched %}
                                    <span class="status-badge bg-red-100 text-red-700 border border-red-200">Nieprzypisana</span>
                                {% elseif isPartial %}
                                    {% set diff = payment.getAmountDifference(transfer) %}
                                    <span class="status-badge bg-orange-100 text-orange-700 mb-1 border border-orange-200">
                                        {% if diff.isNegative %}Niedopłata ({{ diff }}){% else %}Nadpłata (+{{ diff }}){% endif %}
                                    </span><br>
                                    <span class="text-xs text-slate-500">{{ payment.label }} (Wymagane: {{ payment.amount }})</span>
                                {% else %}
                                    <span class="status-badge bg-emerald-50 text-emerald-600 mb-1 border border-emerald-100">Rozpoznano</span><br>
                                    <span class="text-xs text-slate-500">{{ payment.label }}</span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 font-bold {% if not isMatched %}text-red-700{% elseif isPartial %}text-orange-600{% else %}text-[#1a2a52]{% endif %}">
                                {{ transfer.amount }}
                            </td>
                            <td class="px-6 py-4 text-right">
                                {% if not isMatched %}
                                    {{ component('AssignPaymentModalComponent', { transfer: transfer }) }}
                                {% elseif isPartial %}
                                    <button class="text-[10px] font-bold text-[#1a2a52] underline hover:text-[#e8b441]">
                                        Powiadom rodzica
                                    </button>
                                {% else %}
                                    <button class="text-xs font-bold text-slate-400 hover:text-[#1a2a52]">
                                        Szczegóły
                                    </button>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="px-6 py-8 text-center text-[#6b7796]">
                                Brak operacji bankowych
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
