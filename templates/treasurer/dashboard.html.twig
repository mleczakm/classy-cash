{% extends 'treasurer/layout.html.twig' %}

{% block title %}Panel Główny{% endblock %}

{% block page_content %}
<div class="t-view">
    <header class="mb-10 flex flex-col md:flex-row justify-between items-start md:items-end gap-4">
        <div>
            <h1 class="text-3xl font-serif-brand font-bold text-[#1a2a52]">Panel Główny</h1>
            <p class="text-[#6b7796]">Podsumowanie finansów klasy {{ classRoom.name }}.</p>
        </div>
        <a href="{{ path('treasurer_manual_transactions') }}" class="btn-primary py-3 flex items-center gap-2 text-sm shadow-lg shadow-blue-900/10">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M12 5v14M5 12h14"/>
            </svg>
            Nowa transakcja
        </a>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
        <!-- Total Cash Card -->
        {{ component('treasurer:dashboard:total_cash', {
            'classRoom': classRoom
        }) }}

        <!-- Monthly Collected Card -->
        {{ component('treasurer:dashboard:monthly_collected', {
            'classRoom': classRoom
        }) }}

        <!-- Outstanding Payments Card -->
        {{ component('treasurer:dashboard:outstanding_payments', {
            'classRoom': classRoom
        }) }}
    </div>

    <!-- Recent Transactions -->
    {{ component('treasurer:dashboard:recent_payments', {
        'classRoom': classRoom})
    }}
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
<script>
    // Auto-refresh dashboard data every 30 seconds
    setInterval(() => {
        // Trigger live component refreshes
        document.querySelectorAll('[data-live-id]').forEach(el => {
            if (el.__component) {
                el.__component.refreshData();
            }
        });
    }, 30000);
</script>
{% endblock %}
