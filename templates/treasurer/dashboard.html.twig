{% extends 'treasurer/layout.html.twig' %}

{% block title %}Panel Główny{% endblock %}

{% block content %}
<div class="t-view">
    <header class="mb-10 flex flex-col md:flex-row justify-between items-start md:items-end gap-4">
        <div>
            <h1 class="text-3xl font-serif-brand font-bold text-[#1a2a52]">Panel Główny</h1>
            <p class="text-[#6b7796]">Podsumowanie finansów klasy {{ classRoom.name }}.</p>
        </div>
        <a href="{{ path('treasurer_manual_transactions') }}" class="btn-primary py-3 flex items-center gap-2 text-sm shadow-lg shadow-blue-900/10">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M12 5v14M5 12h14"/>
            </svg>
            Nowa transakcja
        </a>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
        <!-- Total Cash Card -->
        <div class="card-elegant !p-6 border-t-4 border-t-[#2aa57f] relative overflow-hidden">
            <p class="text-[10px] uppercase font-bold tracking-widest text-[#6b7796] mb-2">Suma w kasie</p>
            <div class="flex items-baseline gap-1">
                <span class="text-4xl font-serif-brand font-bold text-[#1a2a52]">
                    {{ component('treasurer:dashboard:total_cash').getFormattedAmount()|replace({' ': '<span class="text-xl">,</span>'})|raw }}
                </span>
                <span class="text-xs font-bold text-[#6b7796]">PLN</span>
            </div>
        </div>

        <!-- Monthly Collected Card -->
        <div class="card-elegant !p-6">
            <p class="text-[10px] uppercase font-bold tracking-widest text-[#6b7796] mb-2">Zebrane ({{ component('treasurer:dashboard:monthly_collected').getCurrentMonth() }})</p>
            <div class="flex items-baseline gap-1">
                <span class="text-4xl font-serif-brand font-bold text-[#1a2a52]">
                    {{ component('treasurer:dashboard:monthly_collected').getFormattedAmount()|replace({' ': '<span class="text-xl">,</span>'})|raw }}
                </span>
                <span class="text-xs font-bold text-[#6b7796]">PLN</span>
            </div>
        </div>

        <!-- Outstanding Payments Card -->
        <div class="card-elegant !p-6 border-t-4 border-t-[#d65a4a] bg-red-50/50">
            <p class="text-[10px] uppercase font-bold tracking-widest text-red-700 mb-2">Zaległości</p>
            <div class="flex items-baseline gap-1 text-red-600">
                <span class="text-4xl font-serif-brand font-bold">
                    {{ component('treasurer:dashboard:outstanding_payments').getFormattedAmount()|replace({' ': '<span class="text-xl">,</span>'})|raw }}
                </span>
                <span class="text-xs font-bold">PLN</span>
            </div>
        </div>
    </div>

    <!-- Recent Payments -->
    <div class="card-elegant !p-0 overflow-hidden">
        <div class="p-6 border-b border-slate-100 bg-white">
            <h3 class="font-bold text-[#1a2a52]">Ostatnio zaksięgowane wpłaty</h3>
        </div>
        <div class="overflow-x-auto bg-white">
            {{ component('treasurer:dashboard:recent_payments') }}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    // Auto-refresh dashboard data every 30 seconds
    setInterval(() => {
        // Trigger live component refreshes
        document.querySelectorAll('[data-live-id]').forEach(el => {
            if (el.__component) {
                el.__component.refreshData();
            }
        });
    }, 30000);
</script>
{% endblock %}
