{% extends 'treasurer/layout.html.twig' %}

{% block title %}Zarządzanie Składkami{% endblock %}

{% block page_content %}
<div class="t-view">
    <header class="mb-10">
        <h1 class="text-3xl font-serif-brand font-bold text-[#1a2a52]">Zarządzanie Składkami</h1>
        <p class="text-[#6b7796]">Twórz nowe cele i edytuj obowiązek wpłat dla poszczególnych uczniów.</p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Formularz nowej składki -->
        <div class="lg:col-span-5 card-elegant sticky top-24 bg-white">
            <h2 class="text-xl font-serif-brand font-bold mb-6 text-[#1a2a52]">Utwórz Składkę</h2>
            <form method="post" class="space-y-5">
                <div>
                    <label class="block text-[10px] font-bold uppercase mb-2 text-slate-500">Tytuł składki</label>
                    <input type="text" name="title" class="input-elegant bg-slate-50" placeholder="np. Wycieczka 2-dniowa" required>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-[10px] font-bold uppercase mb-2 text-slate-500">Kwota (PLN)</label>
                        <input type="number" name="amount_pln" step="0.01" class="input-elegant font-bold bg-slate-50" placeholder="0.00" required>
                    </div>
                    <div>
                        <label class="block text-[10px] font-bold uppercase mb-2 text-slate-500">Termin</label>
                        <input type="date" name="due_at" class="input-elegant bg-slate-50">
                    </div>
                </div>

                <div class="pt-4 border-t border-slate-100">
                    <div class="flex justify-between items-center mb-3">
                        <label class="text-[10px] font-bold uppercase text-[#1a2a52]">Przypisz do uczniów</label>
                        <button type="button" onclick="toggleCheckboxes(this)" class="text-[10px] font-bold text-[#e8b441] bg-amber-50 px-2 py-1 rounded">Odznacz wszystkich</button>
                    </div>
                    <div class="max-h-48 overflow-y-auto border border-slate-200 rounded-xl p-2 bg-slate-50 custom-scroll space-y-1">
                        {% for student in students %}
                            <label class="flex items-center gap-3 p-2 hover:bg-white rounded-lg cursor-pointer transition-colors">
                                <input type="checkbox" name="students[]" value="{{ student.id }}" class="w-4 h-4 accent-[#1a2a52] kid-cb" checked> 
                                <span class="text-xs font-semibold">{{ student.firstName }} {{ student.lastName }}</span>
                            </label>
                        {% endfor %}
                    </div>
                </div>
                <button type="submit" class="w-full btn-accent shadow-xl shadow-amber-200/50 mt-4 text-lg">Uruchom Składkę</button>
            </form>
        </div>

        <!-- Lista aktywnych składek -->
        <div class="lg:col-span-7 space-y-6">
            {% for contribution in contributions %}
                <div class="card-elegant !p-0 overflow-hidden bg-white">
                    <div class="p-6 border-b flex justify-between items-center {% if contribution.isOverdue() %}bg-red-600{% else %}bg-[#1a2a52]{% endif %} text-white">
                        <h2 class="text-xl font-serif-brand font-bold">Zbiórka: {{ contribution.title }}</h2>
                        <span class="status-badge {% if contribution.isOverdue() %}bg-red-400/20 text-red-200{% else %}bg-amber-400/20 text-amber-200{% endif %}">
                            {% if contribution.isOverdue() %}Po terminie{% else %}Trwa{% endif %} 
                            {% if contribution.dueAt %}(Termin: {{ contribution.dueAt|date('d.m') }}){% endif %}
                        </span>
                    </div>
                    <div class="p-6">
                        <div class="flex justify-between text-sm mb-2 font-bold">
                            <span class="text-[#6b7796]">Postęp wpłat ({{ contribution.amount|money }})</span>
                            <span class="{% if contribution.progressPercentage >= 100 %}text-[#2aa57f]{% else %}text-orange-600{% endif %}">
                                {{ contribution.paidCount }}/{{ contribution.students|length }} opłacone
                            </span>
                        </div>
                        <div class="w-full bg-slate-100 h-2 rounded-full overflow-hidden mb-8">
                            <div class="{% if contribution.progressPercentage >= 100 %}bg-[#2aa57f]{% else %}bg-[#e8b441]{% endif %} h-full" style="width: {{ min(contribution.progressPercentage, 100) }}%"></div>
                        </div>

                        <p class="text-[10px] font-bold uppercase text-slate-400 tracking-widest mb-4">Zarządzaj przypisaniem (Kto musi zapłacić)</p>

                        <div class="space-y-3">
                            {% for student in contribution.students %}
                                {% set studentPayment = null %}
                                {% for sp in student.studentPayments %}
                                    {% if sp.label == contribution.title %}
                                        {% set studentPayment = sp %}
                                    {% endif %}
                                {% endfor %}

                                {% set isPaid = studentPayment and studentPayment.status == 'paid' %}
                                {% set hasPayment = studentPayment and studentPayment.payment %}
                                
                                <div class="flex justify-between items-center {% if isPaid %}bg-slate-50{% else %}bg-white{% endif %} p-4 rounded-xl border border-slate-200 shadow-sm">
                                    <div class="flex items-center gap-4">
                                        <div class="w-8 h-8 rounded-full {% if isPaid %}bg-emerald-100{% else %}bg-slate-100{% endif %} flex items-center justify-center text-[10px] font-bold {% if isPaid %}text-emerald-600{% else %}text-[#1a2a52]{% endif %}">
                                            {% if isPaid %}
                                                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="3">
                                                    <path d="M20 6L9 17l-5-5"/>
                                                </svg>
                                            {% else %}
                                                {{ student.firstName|first }}{{ student.lastName|first }}
                                            {% endif %}
                                        </div>
                                        <span class="text-sm font-bold text-[#1a2a52]">{{ student.firstName }} {{ student.lastName }}</span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        {% if isPaid %}
                                            <span class="text-[10px] font-bold text-emerald-600 px-3 uppercase tracking-wider">Zapłacono</span>
                                        {% else %}
                                            {{ component('ContributionStudentActions', { 
                                                contribution: contribution, 
                                                student: student, 
                                                studentPayment: studentPayment 
                                            }) }}
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="card-elegant p-8 text-center">
                    <p class="text-[#6b7796]">Brak aktywnych zbiórek</p>
                </div>
            {% endfor %}
        </div>
    </div>
</div>

<script>
    function toggleCheckboxes(btn) {
        const checkboxes = document.querySelectorAll('.kid-cb');
        const isUnchecking = btn.innerText.includes('Odznacz');
        checkboxes.forEach(cb => cb.checked = !isUnchecking);
        btn.innerText = isUnchecking ? 'Zaznacz wszystkich' : 'Odznacz wszystkich';
    }

    // Listen for live component action completion
    document.addEventListener('live:action-success', (event) => {
        if (event.detail.action === 'markAsPaid') {
            window.location.reload();
        }
    });

    document.addEventListener('live:paymentMarkedAsPaid', () => {
        window.location.reload();
    });
</script>
{% endblock %}
