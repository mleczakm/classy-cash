{% extends 'treasurer/layout.html.twig' %}

{% block title %}Uczniowie i Rodzice{% endblock %}

{% block page_content %}
<div class="t-view">
    <header class="mb-10">
        <h1 class="text-3xl font-serif-brand font-bold text-[#1a2a52]">Uczniowie i Rodzice</h1>
        <p class="text-[#6b7796]">Zarządzaj danymi uczniów i łącz wiele kont rodziców z jednym dzieckiem.</p>
    </header>

    <div class="card-elegant !p-0 overflow-hidden bg-white shadow-md border border-slate-200">
        <div class="p-6 border-b flex justify-between items-center bg-slate-50">
            <h3 class="font-bold text-[#1a2a52]">Lista Uczniów {{ classRoom.name }}</h3>
            <!-- Add Student Component (includes button and modal) -->
        {{ component('treasurer:students:add_student') }}
        </div>
        <div class="divide-y divide-slate-100">
            {% for student in students %}
                <div class="p-6 flex flex-col md:flex-row md:items-center justify-between gap-4 hover:bg-slate-50 transition-colors">
                    <div class="flex items-center gap-4">
                        <div class="w-10 h-10 rounded-xl bg-slate-200 flex items-center justify-center text-[#1a2a52] font-serif-brand font-bold">
                            {{ student.firstName|first }}{{ student.lastName|first }}
                        </div>
                        <div>
                            <h4 class="font-bold text-[#1a2a52]">{{ student.firstName }} {{ student.lastName }}</h4>
                            <p class="text-xs text-slate-500 font-mono mt-1">Kod: CC-{{ classRoom.name }}-{{ student.firstName|first }}{{ student.lastName|first }}</p>
                        </div>
                    </div>
                    <div class="flex-1 max-w-md {% if student.parents|length > 1 %}bg-emerald-50 border border-emerald-100{% else %}bg-white border border-slate-200{% endif %} p-3 rounded-xl flex items-start gap-3">
                        <svg width="20" height="20" fill="none" stroke="{% if student.parents|length > 1 %}#2aa57f{% else %}#6b7796{% endif %}" stroke-width="2" class="{% if student.parents|length > 1 %}mt-1{% endif %}">
                            <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                            {% if student.parents|length > 1 %}
                                <path d="M23 21v-2a4 4 0 00-3-3.87m-4-12a4 4 0 010 7.75"/>
                            {% endif %}
                        </svg>
                        <div class="flex-1">
                            <p class="text-[10px] font-bold uppercase {% if student.parents|length > 1 %}text-emerald-700{% else %}text-slate-400{% endif %}">
                                Podpięte konta rodziców ({{ student.parents|length }})
                            </p>
                            {% for parent in student.parents %}
                                <p class="text-xs font-medium text-[#1a2a52]">{{ parent.email }}</p>
                            {% endfor %}
                        </div>
                    </div>
                    <div class="flex gap-2">
                        <button class="px-4 py-2 border border-slate-200 rounded-lg text-xs font-bold text-[#1a2a52] hover:border-[#1a2a52] transition-colors" onclick="editStudent('{{ student.id }}')">
                            Edytuj dane
                        </button>
                        {% if loop.index0 > 0 %}
                            <button class="px-4 py-2 bg-red-50 text-red-600 border border-red-200 rounded-lg text-xs font-bold hover:bg-red-100 transition-colors" onclick="showMergeModal('{{ student.id }}')">
                            Połącz uczniów
                            </button>
                        {% endif %}
                    </div>
                </div>
            {% else %}
                <div class="p-8 text-center text-[#6b7796]">
                    Brak uczniów w klasie
                </div>
            {% endfor %}
        </div>
    </div>

    <!-- Merge Students Modal -->
    <div id="mergeModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden flex items-center justify-center">
        <div class="bg-white rounded-xl p-6 max-w-md w-full mx-4">
            <h3 class="text-lg font-bold text-[#1a2a52] mb-4">Połącz uczniów</h3>
            <form method="post" action="{{ path('treasurer_students') }}" class="space-y-4">
                <input type="hidden" name="merge_students" value="1">
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Uczeń do zachowania (główny)</label>
                    <select name="keep_student_id" class="input-elegant" required>
                        <option value="">Wybierz ucznia...</option>
                        {% for student in students %}
                            <option value="{{ student.id }}">{{ student.firstName }} {{ student.lastName }}</option>
                        {% endfor %}
                    </select>
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Uczeń do usunięcia (duplikat)</label>
                    <select name="delete_student_id" class="input-elegant" required>
                        <option value="">Wybierz ucznia...</option>
                        {% for student in students %}
                            <option value="{{ student.id }}">{{ student.firstName }} {{ student.lastName }}</option>
                        {% endfor %}
                    </select>
                </div>
                
                <div class="text-xs text-gray-600 mb-4">
                    <strong>Uwaga:</strong> Płatności i konta rodziców zostaną przeniesione do ucznia głównego. Uczeń duplikat zostanie oznaczony jako usunięty.
                </div>
                
                <div class="flex gap-2">
                    <button type="button" onclick="hideMergeModal()" class="flex-1 px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50">
                        Anuluj
                    </button>
                    <button type="submit" class="flex-1 btn-primary">
                        Połącz uczniów
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function showAddStudentModal() {
        // Implementation for adding new students
        window.location.href = '{{ path('treasurer_students') }}';
    }

    function editStudent(studentId) {
        // Implementation for editing student
        window.location.href = '';
    }

    function showMergeModal(studentId) {
        document.getElementById('mergeModal').classList.remove('hidden');
    }

    function hideMergeModal() {
        document.getElementById('mergeModal').classList.add('hidden');
    }
</script>
{% endblock %}
