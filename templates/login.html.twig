{% extends 'base.html.twig' %}

{% block header %}
{% endblock %}

{% block body %}
<div id="view-login" class="main-view flex min-h-screen bg-[#f7f6f0]">

        <div class="hidden lg:flex w-1/2 bg-[#1a2a52] text-white p-20 flex-col justify-between relative overflow-hidden">
            <div class="relative z-10">
                <div class="flex items-center gap-4 mb-16 animate-fade-in">
                    <div class="w-14 h-14 bg-white/10 rounded-2xl border border-white/20 flex items-center justify-center p-2.5 backdrop-blur-sm">
                        <svg viewBox="0 0 100 100" class="w-full h-full shadow-2xl">
                            <path d="M50 15L80 35V65L50 85L20 65V35L50 15Z" stroke="#e8b441" stroke-width="5" fill="none" />
                            <circle cx="50" cy="50" r="18" stroke="#e8b441" stroke-width="5" fill="none" />
                            <path d="M50 35V65M42 42H58M42 58H58" stroke="#e8b441" stroke-width="5" stroke-linecap="round" fill="none" />
                        </svg>
                    </div>
                    <span class="text-3xl font-serif-brand font-bold tracking-tight">Classy Cash</span>
                </div>

                <div class="space-y-6">
                    <h1 class="text-6xl xl:text-7xl font-serif-brand font-bold leading-[1.1]">
                        Zarządzaj kasą<br>
                        <span class="italic text-[#e8b441] text-7xl xl:text-8xl">z klasą.</span>
                    </h1>
                    <p class="text-xl text-blue-100/80 max-w-md leading-relaxed font-medium">
                        System klasy premium do automatyzacji finansów szkolnych. Transparentność dla rodziców, spokój dla skarbnika.
                    </p>
                </div>
            </div>

            <div class="relative z-10 text-[10px] font-bold uppercase tracking-[0.4em] opacity-40">
                Created for Excellence • Wersja z {{ last_release()|format_date(pattern: 'HH:mm, dd MMM') }}
            </div>

            <div class="absolute top-[-10%] right-[-10%] w-[500px] h-[500px] bg-[#e8b441]/10 rounded-full blur-[120px] pointer-events-none"></div>
            <div class="absolute bottom-[-10%] left-[-10%] w-[600px] h-[600px] bg-[#2aa57f]/10 rounded-full blur-[140px] pointer-events-none"></div>
        </div>

        <div class="w-full lg:w-1/2 flex items-center justify-center p-4 sm:p-8 md:p-12 relative">

            <div class="lg:hidden absolute inset-0 overflow-hidden pointer-events-none">
                <div class="absolute top-[-10%] right-[-10%] w-64 h-64 bg-[#e8b441]/5 rounded-full blur-3xl"></div>
                <div class="absolute bottom-[-5%] left-[-5%] w-80 h-80 bg-[#1a2a52]/5 rounded-full blur-3xl"></div>
            </div>

            <div class="w-full max-w-[440px] bg-white rounded-[32px] shadow-[0_8px_30px_rgb(0,0,0,0.04)] lg:shadow-none p-8 sm:p-12 md:p-16 lg:p-0 lg:bg-transparent relative z-10 border border-slate-100 lg:border-none">

                <div class="lg:hidden flex flex-col items-center mb-10 text-center">
                    <div class="w-16 h-16 bg-[#1a2a52] rounded-[22px] flex items-center justify-center p-3 shadow-xl mb-4 rotate-3">
                        <svg viewBox="0 0 100 100" class="w-full h-full">
                            <path d="M50 15L80 35V65L50 85L20 65V35L50 15Z" stroke="#e8b441" stroke-width="6" fill="none" />
                            <circle cx="50" cy="50" r="18" stroke="#e8b441" stroke-width="6" fill="none" />
                            <path d="M50 35V65M42 42H58M42 58H58" stroke="#e8b441" stroke-width="6" stroke-linecap="round" fill="none" />
                        </svg>
                    </div>
                    <h2 class="text-3xl font-serif-brand font-bold text-[#1a2a52]">Classy Cash</h2>
                    <p class="text-xs text-[#6b7796] mt-1 font-medium uppercase tracking-widest">Witaj w klasie</p>
                </div>

                <div class="hidden lg:block mb-10">
                    <h2 class="text-4xl font-serif-brand font-bold text-[#1a2a52] mb-2">Zaloguj się</h2>
                    <p class="text-[#6b7796]">Dostęp do Twojego portfela klasowego.</p>
                </div>

                {{ component('LoginUser') }}

                <p class="mt-10 text-center text-sm text-[#6b7796] font-medium leading-relaxed">
                    Nie masz konta? <br class="sm:hidden">
                    <a href="{{ path('onboarding') }}" class="text-[#1a2a52] font-bold hover:underline">Zarejestruj klasę</a>
                    <span class="mx-1 text-slate-300">|</span>
                    <a href="#" onclick="goTo('parent-reg')" class="text-[#1a2a52] font-bold hover:underline">Dołącz jako rodzic</a>
                </p>
            </div>
        </div>
    </div>
{% endblock %}