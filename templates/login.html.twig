{% extends 'base.html.twig' %}

{% block header %}
{% endblock %}

{% block body %}
    <div class="split">
        <div class="form-side">
            <a class="brand" href="{{ path('homepage') }}" style="margin-bottom:48px">
                <span class="brand-mark">CC</span>
                <span class="brand-name">Classy<span>Cash</span></span>
            </a>
            <div class="form-card">
                <h1>{{ 'form.login.header'|trans }}</h1>
                <p class="lead">{{ 'form.login.lead'|trans }}</p>

                {{ component('LoginUser') }}

                <div class="divider">{{ 'form.login.divider'|trans }}</div>

                <button class="btn btn-outline btn-block" type="button">
                    <svg width="16" height="16" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.1c-.22-.66-.35-1.36-.35-2.1s.13-1.44.35-2.1V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.83z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.83C6.71 7.31 9.14 5.38 12 5.38z"/></svg>
                    {{ 'form.login.continue_with_google'|trans }}
                </button>

                <p style="margin-top:28px;text-align:center;color:var(--muted);font-size:14px">
                    {{ 'form.login.no_account'|trans }}
                    <a href="" style="color:var(--secondary);font-weight:600">{{ 'form.login.join_as_parent'|trans }}</a>
                    ·
                    <a href="{{ path('first_admin_setup') }}" style="color:var(--secondary);font-weight:600">{{ 'form.login.create_class'|trans }}</a>
                </p>
            </div>
        </div>

        <div class="brand-side">
            <div class="content">
                <p style="text-transform:uppercase;letter-spacing:.3em;font-size:12px;opacity:.7">{{ 'brand.name'|trans }}</p>
                <h2>{{ 'brand.tagline'|trans }}</h2>
                <p style="opacity:.85">{{ 'brand.description'|trans }}</p>
                <ul>
                    <li>✓ {{ 'brand.feature.fundraising'|trans }}</li>
                    <li>✓ {{ 'brand.feature.blik'|trans }}</li>
                    <li>✓ {{ 'brand.feature.reporting'|trans }}</li>
                    <li>✓ {{ 'brand.feature.email_confirmations'|trans }}</li>
                </ul>
            </div>
        </div>
    </div>
{% endblock %}