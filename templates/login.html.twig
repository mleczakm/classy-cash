{% extends 'base.html.twig' %}

{% block header %}
{% endblock %}

{% block body %}
    <div id="view-login" class="min-h-screen flex">

        <!-- Lewa strona (Desktop) - Prestiżowy Branding -->
        <div class="md:flex w-1/2 bg-[#1a2a52] text-white p-16 flex-col justify-between relative overflow-hidden">
            <div class="relative z-10">
                <div class="flex items-center gap-3 mb-16">
                    <div class="w-12 h-12 bg-white/10 rounded-xl border border-white/20 flex items-center justify-center p-2">
                        <svg viewBox="0 0 100 100" class="w-full h-full">
                            <path d="M50 15L80 35V65L50 85L20 65V35L50 15Z" stroke="#e8b441" stroke-width="4" fill="none"></path>
                            <circle cx="50" cy="50" r="15" stroke="#e8b441" stroke-width="4" fill="none"></circle>
                            <path d="M50 35V65M42 42H58M42 58H58" stroke="#e8b441" stroke-width="4" stroke-linecap="round" fill="none"></path>
                        </svg>
                    </div>
                    <span class="text-2xl font-serif-brand font-bold tracking-tight">Classy Cash</span>
                </div>
                <h1 class="text-5xl lg:text-6xl font-serif-brand font-bold leading-tight mb-6">
                    Zarządzaj kasą<br><span class="italic text-[#e8b441]">z klasą.</span>
                </h1>
                <p class="text-lg text-blue-200 max-w-md leading-relaxed font-medium">
                    Twój zaufany asystent do spraw finansów klasowych. Automatyzacja, przejrzystość i prestiż w jednym miejscu.
                </p>
            </div>
            <div class="relative z-10">
                <p class="text-sm text-blue-300 opacity-60">System dla nowoczesnych skarbników i wygodnych rodziców.</p>
            </div>
            <!-- Dekory Tła -->
            <div class="absolute top-[-10%] right-[-10%] w-[500px] h-[500px] bg-[#e8b441]/10 rounded-full blur-[100px] pointer-events-none"></div>
            <div class="absolute bottom-[-10%] left-[-10%] w-[600px] h-[600px] bg-[#2aa57f]/10 rounded-full blur-[120px] pointer-events-none"></div>
        </div>

        <!-- Prawa strona (Formularz) -->
        <div class="w-full md:w-1/2 flex items-center justify-center p-6 bg-[#f7f6f0] md:bg-white relative">
            <div class="w-full max-w-md bg-white rounded-[24px] shadow-xl md:shadow-none p-10 md:p-0 md:bg-transparent relative z-10">

                <!-- Mobile Logo (Widoczne tylko na małych ekranach) -->
                <div class="md:hidden flex flex-col items-center justify-center gap-3 mb-10">
                    <svg width="56" height="56" viewBox="0 0 100 100" class="mb-2 shadow-lg rounded-2xl"><use href="#brand-logo"/></svg>
                    <span class="text-2xl font-serif-brand font-bold text-[#1a2a52]">Classy Cash</span>
                </div>

                <h2 class="text-3xl font-serif-brand font-bold text-[#1a2a52] mb-2 text-center md:text-left">Zaloguj się</h2>
                <p class="text-[#6b7796] mb-10 text-center md:text-left">Uzyskaj dostęp do panelu finansowego klasy.</p>

                <form class="space-y-5" onsubmit="event.preventDefault(); goTo('p-dash');">
                    <div>
                        <label class="block text-[10px] font-bold uppercase tracking-widest text-[#1a2a52] mb-2">Adres Email</label>
                        <input type="email" class="input-elegant bg-slate-50 focus:bg-white" placeholder="twoj@email.com" required>
                    </div>

                    <!-- Sekcja hasła domyślnie ukryta -->
                    <div id="password-container" class="hidden">
                        <div class="flex justify-between items-center mb-2">
                            <label class="text-[10px] font-bold uppercase tracking-widest text-[#1a2a52]">Hasło</label>
                            <a href="#" class="text-[10px] font-bold text-[#e8b441] hover:underline">Zapomniałeś hasła?</a>
                        </div>
                        <input type="password" class="input-elegant bg-slate-50 focus:bg-white" placeholder="••••••••">
                    </div>

                    <div class="pt-4 space-y-4">
                        <button type="submit" class="w-full btn-primary shadow-lg shadow-blue-900/20">Zaloguj się</button>

                        <!-- Przycisk przełączający tryb logowania -->
                        <div class="text-center">
                            <button type="button" id="toggle-password-btn" onclick="togglePassword()" class="text-sm font-bold text-[#6b7796] hover:text-[#1a2a52] transition-colors">
                                Zaloguj się hasłem
                            </button>
                        </div>
                    </div>
                </form>

                <p class="mt-12 text-center text-sm text-[#6b7796] border-t border-slate-200 pt-6">
                    Nie masz konta? <a href="#" onclick="goTo('setup')" class="text-[#1a2a52] font-bold hover:underline">Zarejestruj klasę</a> lub <a href="#" onclick="goTo('parent-reg')" class="text-[#1a2a52] font-bold hover:underline">dołącz jako rodzic</a>
                </p>
            </div>
        </div>
    </div>
{% endblock %}