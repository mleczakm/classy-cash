{% extends 'base.html.twig' %}

{% block body %}
    
    <main class="flex-grow">
        <div class="container">
            <!-- Hero Section -->
            <section class="hero mt-8">
                <div class="eyebrow">Witaj z powrotem!</div>
                <h1>Pulpit skarbnika klasy</h1>
                <p>Zarządzaj finansami klasy, śledź wpłaty i kontroluj wydatki w jednym miejscu.</p>
                <div class="actions">
                    <button class="btn btn-primary">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 5v14M5 12h14"/>
                        </svg>
                        Nowa wpłata
                    </button>
                    <button class="btn btn-outline">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M9 11H3m6 0v6m0-6l-7 7M15 13h6m-6 0v6m0-6l7 7"/>
                        </svg>
                        Generuj raport
                    </button>
                </div>
            </section>

            <!-- Stats Grid -->
            <section class="stats">
                <div class="stat">
                    <div class="stat-change">+12%</div>
                    <div class="stat-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                        </svg>
                    </div>
                    <div class="stat-value">2 450 zł</div>
                    <div class="stat-label">Całkowity budżet</div>
                </div>
                <div class="stat">
                    <div class="stat-change">+8%</div>
                    <div class="stat-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
                        </svg>
                    </div>
                    <div class="stat-value">1 820 zł</div>
                    <div class="stat-label">Zebrane środki</div>
                </div>
                <div class="stat">
                    <div class="stat-change">+2</div>
                    <div class="stat-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                            <path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
                        </svg>
                    </div>
                    <div class="stat-value">24/25</div>
                    <div class="stat-label">Aktywnych uczniów</div>
                </div>
                <div class="stat">
                    <div class="stat-change">-5%</div>
                    <div class="stat-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                            <polyline points="7 10 12 15 17 10"/>
                            <line x1="12" y1="15" x2="12" y2="3"/>
                        </svg>
                    </div>
                    <div class="stat-value">630 zł</div>
                    <div class="stat-label">Wydatki</div>
                </div>
            </section>

            <!-- Two Column Layout -->
            <div class="grid-2">
                <!-- Recent Transactions -->
                <div class="card">
                    <div class="card-header">
                        <h2>Ostatnie transakcje</h2>
                        <button class="btn btn-ghost">Zobacz wszystkie</button>
                    </div>
                    <div class="card-body">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Data</th>
                                    <th>Uczeń</th>
                                    <th>Kategoria</th>
                                    <th>Kwota</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>15.05.2024</td>
                                    <td>Jan Kowalski</td>
                                    <td>Wycieczka</td>
                                    <td class="amount pos">+150 zł</td>
                                    <td><span class="badge badge-success">Opłacone</span></td>
                                </tr>
                                <tr>
                                    <td>14.05.2024</td>
                                    <td>Anna Nowak</td>
                                    <td>Kieszonkowe</td>
                                    <td class="amount pos">+50 zł</td>
                                    <td><span class="badge badge-success">Opłacone</span></td>
                                </tr>
                                <tr>
                                    <td>13.05.2024</td>
                                    <td>Piotr Wiśniewski</td>
                                    <td>Materiały</td>
                                    <td class="amount neg">-120 zł</td>
                                    <td><span class="badge badge-warning">Oczekuje</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="card">
                    <div class="card-header">
                        <h2>Szybkie akcje</h2>
                    </div>
                    <div class="card-body">
                        <div style="display: flex; flex-direction: column; gap: 12px;">
                            <button class="btn btn-outline btn-block">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                    <polyline points="14 2 14 8 20 8"/>
                                    <line x1="16" y1="13" x2="8" y2="13"/>
                                    <line x1="16" y1="17" x2="8" y2="17"/>
                                    <polyline points="10 9 9 9 8 9"/>
                                </svg>
                                Dodaj nowego ucznia
                            </button>
                            <button class="btn btn-outline btn-block">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="10"/>
                                    <polyline points="12 6 12 12 16 14"/>
                                </svg>
                                Planuj wycieczkę
                            </button>
                            <button class="btn btn-outline btn-block">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                                    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                                </svg>
                                Zarządzaj karnetami
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Progress Section -->
            <div class="card" style="margin-top: 28px;">
                <div class="card-header">
                    <h2>Postęp zbiórek</h2>
                </div>
                <div class="card-body">
                    <div style="margin-bottom: 24px;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                            <span style="font-weight: 600;">Wycieczka do Krakowa</span>
                            <span style="color: var(--secondary); font-weight: 600;">74%</span>
                        </div>
                        <div class="progress">
                            <span style="width: 74%;"></span>
                        </div>
                        <div style="display: flex; justify-content: space-between; margin-top: 6px; font-size: 13px; color: var(--muted);">
                            <span>1 850 zł zebrane</span>
                            <span>2 500 zł cel</span>
                        </div>
                    </div>
                    
                    <div style="margin-bottom: 24px;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                            <span style="font-weight: 600;">Materiały edukacyjne</span>
                            <span style="color: var(--secondary); font-weight: 600;">92%</span>
                        </div>
                        <div class="progress">
                            <span style="width: 92%;"></span>
                        </div>
                        <div style="display: flex; justify-content: space-between; margin-top: 6px; font-size: 13px; color: var(--muted);">
                            <span>460 zł zebrane</span>
                            <span>500 zł cel</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
{% endblock %}