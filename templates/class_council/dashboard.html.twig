{% extends 'base.html.twig' %}

{% block body %}
    
    <main class="flex-grow">
        <div class="container">
            {% if classRoom %}
                <!-- Hero Section -->
                <section class="hero mt-8">
                    <div class="eyebrow">Panel rodzica</div>
                    <h1>Rada Klasowa – Panel</h1>
                    <p>Twoja klasa: <strong>{{ classRoom.name }}</strong></p>
                    <div class="actions">
                        <button class="btn btn-outline">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                            </svg>
                            Ustawienia
                        </button>
                    </div>
                </section>

                {# Payments overview for current user's children #}
                {% if students is defined and students|length > 0 %}
                    <!-- Missing Payments Alert -->
                    {% if hasMissingPayments %}
                        <div class="card" style="margin-top: 28px; border-color: var(--accent); background: #fff3d6;">
                            <div class="card-body" style="display: flex; align-items: center; justify-content: space-between; gap: 16px;">
                                <div style="display: flex; align-items: center; gap: 12px;">
                                    <div style="width: 40px; height: 40px; border-radius: 12px; background: var(--accent); display: flex; align-items: center; justify-content: center; color: white;">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                                            <line x1="12" y1="9" x2="12" y2="13"/>
                                            <line x1="12" y1="17" x2="12.01" y2="17"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <div style="font-weight: 600; margin-bottom: 4px;">Masz nieopłacone składki</div>
                                        <div style="font-size: 14px; color: var(--muted);">Możesz skorzystać z szybkiej płatności i opłacić wszystkie wymagane składki jedną transakcją.</div>
                                    </div>
                                </div>
                                {{ component('FastPaymentModalComponent') }}
                            </div>
                        </div>
                    {% endif %}

                    <!-- Students Payments Section -->
                    <section style="margin-top: 28px;">
                        <div class="section-title">Moje dzieci i wymagane składki</div>
                        <div class="section-sub">Sprawdź status płatności dla każdego dziecka</div>
                        
                        {% for s in students %}
                            {% set key = s.id ~ '' %}
                            {% set payments = (paymentsByStudent is defined and paymentsByStudent[key] is defined) ? paymentsByStudent[key] : [] %}
                            
                            <div class="card" style="margin-bottom: 16px;">
                                <div class="card-header">
                                    <div style="display: flex; align-items: center; gap: 12px;">
                                        <div style="width: 40px; height: 40px; border-radius: 12px; background: var(--secondary-soft); display: flex; align-items: center; justify-content: center; color: var(--secondary);">
                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                                <circle cx="12" cy="7" r="4"/>
                                            </svg>
                                        </div>
                                        <div>
                                            <h3 style="margin: 0; font-size: 18px;">{{ s.firstName }} {{ s.lastName }}</h3>
                                            <div style="font-size: 14px; color: var(--muted);">
                                                {% set paidCount = 0 %}
                                                {% set totalCount = payments|length %}
                                                {% for p in payments %}
                                                    {% if p.status == 'paid' %}
                                                        {% set paidCount = paidCount + 1 %}
                                                    {% endif %}
                                                {% endfor %}
                                                {{ paidCount }}/{{ totalCount }} opłacone
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-body">
                                    {% if payments|length > 0 %}
                                        <table class="table">
                                            <thead>
                                                <tr>
                                                    <th>Składka</th>
                                                    <th>Kwota</th>
                                                    <th>Status</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                {% for p in payments %}
                                                    <tr>
                                                        <td>{{ p.label }}</td>
                                                        <td>{{ p.amount|money }}</td>
                                                        <td>
                                                            {% set status = p.status %}
                                                            {% if status == 'paid' %}
                                                                <span class="badge badge-success">opłacona</span>
                                                            {% elseif status == 'partial' %}
                                                                <span class="badge badge-warning">częściowa</span>
                                                            {% else %}
                                                                <span class="badge badge-danger">nieopłacona</span>
                                                                {{ component('FastPaymentModalComponent', {studentPaymentIds: [p.id], class: "inline-flex", size: 'sm'}) }}
                                                            {% endif %}
                                                        </td>
                                                    </tr>
                                                {% endfor %}
                                            </tbody>
                                        </table>
                                    {% else %}
                                        <div style="color: var(--muted); font-size: 14px;">Brak zdefiniowanych składek dla tej klasy.</div>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </section>

                {% else %}
                    <!-- Add Child Section -->
                    <section style="margin-top: 28px;">
                        <div class="card">
                            <div class="card-header">
                                <div style="display: flex; align-items: center; gap: 12px;">
                                    <div style="width: 40px; height: 40px; border-radius: 12px; background: var(--secondary-soft); display: flex; align-items: center; justify-content: center; color: var(--secondary);">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                            <circle cx="8.5" cy="7" r="4"/>
                                            <line x1="20" y1="8" x2="20" y2="14"/>
                                            <line x1="23" y1="11" x2="17" y2="11"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <h2 style="margin: 0;">Dodaj dziecko</h2>
                                        <div style="font-size: 14px; color: var(--muted); margin-top: 4px;">Dodaj swoje dzieci, aby śledzić ich płatności</div>
                                    </div>
                                </div>
                            </div>
                            <div class="card-body">
                                <form method="post" action="{{ path('cc_students') }}" style="max-width: 600px;">
                                    <div class="input-row">
                                        <div class="form-group">
                                            <label>Imię</label>
                                            <input name="first_name" type="text" class="input" required>
                                        </div>
                                        <div class="form-group">
                                            <label>Nazwisko</label>
                                            <input name="last_name" type="text" class="input" required>
                                        </div>
                                    </div>
                                    <button type="submit" class="btn btn-primary">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                            <circle cx="8.5" cy="7" r="4"/>
                                            <line x1="20" y1="8" x2="20" y2="14"/>
                                            <line x1="23" y1="11" x2="17" y2="11"/>
                                        </svg>
                                        Dodaj dziecko
                                    </button>
                                </form>
                            </div>
                        </div>
                    </section>
                {% endif %}

            {% else %}
                <!-- No Class Section -->
                <section class="hero mt-8" style="text-align: center;">
                    <div class="eyebrow">Witaj w</div>
                    <h1>Classy Cash!</h1>
                    <p>Wygląda na to, że nie zarządzasz jeszcze żadną klasą. Utwórz swoją pierwszą klasę, aby zacząć zbierać składki i zarządzać wydatkami.</p>
                    <div class="actions" style="justify-content: center;">
                        <a href="{{ path('cc_create_class') }}" class="btn btn-primary">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M5 12h14"/>
                                <path d="M12 5v14"/>
                            </svg>
                            Utwórz pierwszą klasę
                        </a>
                    </div>
                </section>

                <!-- Help Section -->
                <div class="container">
                    <div class="card" style="margin-top: 28px; max-width: 600px; margin-left: auto; margin-right: auto;">
                        <div class="card-body" style="text-align: center;">
                            <div style="width: 60px; height: 60px; border-radius: 12px; background: var(--secondary-soft); display: flex; align-items: center; justify-content: center; color: var(--secondary); margin: 0 auto 16px;">
                                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="10"/>
                                    <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
                                    <line x1="12" y1="17" x2="12.01" y2="17"/>
                                </svg>
                            </div>
                            <h3 style="margin-bottom: 8px;">Potrzebujesz pomocy?</h3>
                            <p style="color: var(--muted); font-size: 14px;">Zajrzyj do ustawień, aby skonfigurować płatności BLIK.</p>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
    </main>
{% endblock %}
