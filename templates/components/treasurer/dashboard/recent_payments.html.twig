<div {{ attributes.defaults(stimulus_controller('appear')) }}
    class="card-elegant !p-0 overflow-hidden bg-white border border-slate-200 shadow-sm relative">
    <div class="p-8 border-slate-50 bg-white sticky top-0 z-10">
        <h3 class="font-bold text-[#1a2a52] text-lg uppercase tracking-tight">Ostatnio zaksięgowane operacje</h3>
        <p class="text-[11px] text-slate-400 font-medium mt-1">Nieskończona historia przepływów (Autoloading)</p>
    </div>
    <div class="overflow-x-auto bg-white">
        <table class="w-full text-left whitespace-nowrap">
            <thead class="bg-slate-50/50 border-slate-100 text-[10px] uppercase font-bold text-slate-400 tracking-[0.1em]">
                <tr>
                    <th class="px-8 py-4">Opis operacji / Cel</th>
                    <th class="px-8 py-4 text-center">Data</th>
                    <th class="px-8 py-4">Kwota</th>
                    <th class="px-8 py-4">Saldo po</th>
                    <th class="px-8 py-4 text-right">Status</th>
                </tr>
            </thead>
            <tbody id="operations-body" class="divide-y divide-slate-50 text-sm">
                {# 1. Trick: Keep previous results by "ignoring" them #}
                {% if page > 1 %}
                    <tr id="operation-{{ (page - 1) * 10 }}" data-live-ignore style="display: none;"></tr>
                {% endif %}

                {% set items = this.getItems() %}
                {% for transaction in items %}
                    {% set itemIndex = loop.index0 + ((page - 1) * 10) %}
                    <tr id="operation-{{ itemIndex }}" 
                        data-live-ignore
                        class="hover:bg-slate-50/50 transition-colors">
                        <td class="px-8 py-5 text-wrap">
                            {% if transaction.student %}
                                <div class="font-bold text-[#1a2a52]">{{ transaction.student.firstName }} {{ transaction.student.lastName }}</div>
                                <div class="text-[10px] font-normal text-[#6b7796]">{{ transaction.description }} ({{ transaction.method }})</div>
                            {% else %}
                                <div class="font-bold text-[#1a2a52]">{{ transaction.description }}</div>
                                <div class="text-[10px] font-normal text-[#6b7796]">{{ transaction.method }}</div>
                            {% endif %}
                        </td>
                        <td class="px-8 py-5 text-center text-slate-400 font-medium">
                            {% if transaction.date|date('Y-m-d') == 'now'|date('Y-m-d') %}
                                Dziś, {{ transaction.date|date('H:i') }}
                            {% else %}
                                {{ transaction.date|format_datetime(pattern='dd.MM.yyyy') }}
                            {% endif %}
                        </td>
                        <td class="px-8 py-5 font-bold {% if transaction.type == 'income' %}text-[#2aa57f]{% else %}text-[#d65a4a]{% endif %}">
                            {% if transaction.type == 'income' %}+{% endif %}{{ transaction.amount|money }}
                        </td>
                        <td class="px-8 py-5 font-mono text-slate-400 text-xs {% if transaction.balanceAfter is not null %}font-bold text-slate-600{% else %}italic{% endif %}">
                            {% if transaction.balanceAfter is not null %}{{ transaction.balanceAfter|money }}{% else %}---{% endif %}
                        </td>
                        <td class="px-8 py-5 text-right">
                            {% if transaction.type == 'income' %}
                                <span class="status-badge bg-emerald-50 text-emerald-600 border border-emerald-100">Wpłata</span>
                            {% else %}
                                <span class="status-badge bg-red-50 text-red-600 border border-red-100">Koszt</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}

                {# 2. Render placeholders for the NEXT page #}
                {% if this.hasMore %}
                    {# The first placeholder acts as the "Intersection" trigger #}
                    <tr id="operation-{{ page * 10 }}"
                        data-appear-target="loader"
                        data-action="appear->live#action"
                        data-live-action-param="debounce(750)|more">
                        <td colspan="5" class="p-12 text-center bg-slate-50/20">
                            <div class="flex flex-col items-center gap-3">
                                <svg class="animate-spin w-6 h-6 text-[#e8b441]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                                    <circle cx="12" cy="12" r="10" stroke="currentColor" opacity="0.2"></circle>
                                    <path d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" fill="currentColor"></path>
                                </svg>
                                <span class="text-[11px] font-bold text-[#6b7796] uppercase tracking-[0.1em]">Pobieranie starszych operacji...</span>
                            </div>
                        </td>
                    </tr>
                    {# Additional placeholders to maintain list structure during loading #}
                    {% for i in 1..9 %}
                        <tr id="operation-{{ (page * 10) + i }}" style="display: none;" data-live-ignore></tr>
                    {% endfor %}
                {% else %}
                    {% if items|length == 0 and page == 1 %}
                        <tr>
                            <td colspan="5" class="p-12 text-center">
                                <div class="text-xs text-slate-400 font-medium italic">Brak operacji do wyświetlenia</div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="p-12 text-center">
                                <div class="text-xs text-slate-300 font-medium italic">Koniec historii finansowej</div>
                            </td>
                        </tr>
                    {% endif %}
                {% endif %}
            </tbody>
        </table>
    </div>
</div>
