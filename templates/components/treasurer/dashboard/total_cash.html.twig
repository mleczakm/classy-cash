<div {{ attributes }}>
    <div class="card-elegant !p-6 border-t-4 {% if this.isNegative() %}border-t-[#d65a4a]{% else %}border-t-[#2aa57f]{% endif %} relative overflow-hidden">
        <p class="text-[10px] uppercase font-bold tracking-widest text-[#6b7796] mb-2">Suma w kasie</p>
        <div class="flex items-baseline gap-1">
            <span class="text-4xl font-serif-brand font-bold {% if this.isNegative() %}text-[#d65a4a]{% else %}text-[#1a2a52]{% endif %}">
                {{ this.getTotalCash()|money }}
            </span>
        </div>
    </div>
</div>
