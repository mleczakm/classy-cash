<div {{ attributes }}>
    {% if student in contribution.students %}
        <div class="flex items-center gap-2">
            {% if studentPayment and studentPayment.payment %}
                <div class="flex items-center gap-1 bg-indigo-50 px-3 py-1.5 rounded-md border border-indigo-100">
                    <span class="text-[9px] uppercase text-indigo-400 font-bold tracking-tighter">Kod:</span>
                    <span class="text-xs font-mono font-bold text-indigo-700 tracking-wider">{{ studentPayment.payment.paymentCode.code }}</span>
                </div>
            {% elseif studentPayment %}
                <button 
                    type="button" 
                    data-action="live#action" 
                    data-live-action-param="createPayment"
                    class="px-3 py-1.5 text-[10px] font-bold text-indigo-600 bg-indigo-50 hover:bg-indigo-100 rounded-md transition-colors border border-indigo-100 disabled:opacity-50 disabled:cursor-not-allowed"
                    data-loading="action(createPayment):attr(disabled)"
                >
                    <span data-loading="action(createPayment):hide">Utwórz płatność</span>
                    <span class="hidden" data-loading="action(createPayment):show">Tworzenie...</span>
                </button>
            {% endif %}
            
            <button 
                type="button" 
                data-action="live#action" 
                data-live-action-param="cancel"
                class="px-3 py-1.5 text-[10px] font-bold text-red-600 bg-red-50 hover:bg-red-100 rounded-md transition-colors border border-red-100 disabled:opacity-50 disabled:cursor-not-allowed"
                data-loading="action(cancel):attr(disabled)"
            >
                <span data-loading="action(cancel):hide">Anuluj</span>
                <span class="hidden" data-loading="action(cancel):show">Anulowanie...</span>
            </button>
        </div>
    {% else %}
        <span class="text-[10px] font-bold text-slate-400 px-3 uppercase tracking-wider">Anulowano</span>
    {% endif %}
</div>
