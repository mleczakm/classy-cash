<div {{ attributes }}>
    <!-- Add Student Button -->
    <button data-action="live#action" data-live-action-param="openModal"
            class="btn-primary !py-2.5 text-xs flex items-center gap-2">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" class="stroke-white"><use href="#icon-plus"></use></svg>
        Dodaj ucznia
    </button>

    <!-- Add Student Modal -->
    {% if this.modalOpened %}
        <div id="modal-overlay" class="modal-overlay active" data-action="live#action"
             data-live-action-param="closeModal">
            <div class="modal-content" onclick="event.stopPropagation()">
                <button data-action="live#action" data-live-action-param="closeModal"
                        class="absolute top-6 right-6 p-2 text-slate-400 hover:text-[#1a2a52] transition-colors bg-slate-50 rounded-full">
                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M18 6L6 18M6 6l12 12"/>
                    </svg>
                </button>
                <div id="modal-body" class="p-8 md:p-10">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-12 h-12 bg-slate-100 rounded-2xl flex items-center justify-center">
                            <svg width="24" height="24" fill="none" viewBox="0 0 24 24" class="stroke-[#1a2a52]">
                                <path d="M12 5v14M5 12h14" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <h2 class="text-3xl font-serif-brand font-bold text-[#1a2a52]">Dodaj Ucznia</h2>
                    </div>
                    <p class="text-sm text-[#6b7796] mb-8">Wprowadź dane nowego dziecka do
                        klasy {{ this.getClassCode() }}.</p>

                    {% if this.isSubmitted() and this.isSuccessful() %}
                        <div class="text-center py-8">
                            <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
                                <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"
                                     class="text-green-600">
                                    <path d="M20 6L9 17l-5-5"/>
                                </svg>
                            </div>
                            <h4 class="text-lg font-semibold text-gray-900 mb-2">Uczeń dodany pomyślnie!</h4>
                            <p class="text-gray-600 mb-6">Uczeń został dodany do systemu.</p>
                            <button type="button" data-action="live#action" data-live-action-param="closeModal"
                                    class="w-full btn-primary py-4 shadow-xl shadow-blue-900/10">
                                Zamknij
                            </button>
                        </div>
                    {% else %}
                        {{ form_start(form, {'attr': {'class': 'space-y-6', 'data-action': 'live#action', 'data-live-action-param': 'addStudent'}}) }}
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                {{ form_widget(form.firstName, {'attr': {'class': 'input-elegant bg-slate-50', 'placeholder': 'Imię'}}) }}
                                {{ form_errors(form.firstName) }}
                            </div>
                            <div>
                                {{ form_widget(form.lastName, {'attr': {'class': 'input-elegant bg-slate-50', 'placeholder': 'Nazwisko'}}) }}
                                {{ form_errors(form.lastName) }}
                            </div>
                        </div>

                        <div class="space-y-2">
                            <label class="block text-sm font-medium text-gray-700 mb-2">Rodzice (opcjonalnie)</label>
                            <div class="flex items-center gap-2">
                                <select class="input-elegant flex-1" disabled>
                                    <option value>Funkcja w przygotowaniu...</option>
                                </select>
                                <button type="button" class="btn-primary py-2" disabled>
                                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M12 5v14M5 12h14"/>
                                    </svg>
                                </button>
                            </div>
                        </div>

                        <button type="submit" class="w-full btn-primary py-4 shadow-xl shadow-blue-900/10">
                            Dodaj do listy
                        </button>
                        {{ form_end(form) }}
                    {% endif %}
                </div>
            </div>
        </div>
    {% endif %}
</div>