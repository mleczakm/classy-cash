<div {{ attributes }}>
    {% if not this.modalOpened %}
        <button
                data-action="live#action"
                data-live-action-param="openModal"
                class="bg-[#1a2a52] text-white px-4 py-1.5 rounded-lg text-[10px] font-bold shadow-md hover:bg-[#2a4a7a] transition-colors">
            Przypisz ręcznie
        </button>
    {% else %}
        {# Overlay #}
        <div data-action="click->live#action" data-live-action-param="closeModal"
             class="fixed inset-0 z-50 bg-[#1a2a52]/40 backdrop-blur-sm"></div>

        {# Dialog #}
        <div role="dialog"
             class="fixed left-[50%] top-[50%] z-50 grid w-full max-w-2xl translate-x-[-50%] translate-y-[-50%] gap-4 border bg-white p-8 shadow-2xl rounded-2xl">

            <div class="flex flex-col space-y-2 text-left">
                <h2 class="text-2xl font-serif-brand font-bold text-[#1a2a52]">Ręczne przypisanie płatności</h2>
                <p class="text-sm text-[#6b7796]">Wybierz oczekującą płatność, do której chcesz przypisać ten przelew.</p>
            </div>

            {% if this.transfer %}
                <div class="space-y-6">
                    <div class="bg-slate-50 p-5 rounded-xl border border-slate-100">
                        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-4">Szczegóły przelewu</h3>
                        <div class="grid grid-cols-2 gap-y-4 gap-x-8">
                            <div>
                                <label class="text-[10px] font-bold uppercase text-slate-500 block mb-1">Nadawca</label>
                                <p class="font-bold text-[#1a2a52] text-sm">{{ this.transfer.sender }}</p>
                            </div>
                            <div>
                                <label class="text-[10px] font-bold uppercase text-slate-500 block mb-1">Numer konta</label>
                                <p class="font-mono text-[#1a2a52] text-xs">{{ this.transfer.accountNumber }}</p>
                            </div>
                            <div class="col-span-2">
                                <label class="text-[10px] font-bold uppercase text-slate-500 block mb-1">Tytuł przelewu</label>
                                <p class="font-bold text-[#1a2a52] italic font-mono text-xs">"{{ this.transfer.title }}"</p>
                            </div>
                            <div>
                                <label class="text-[10px] font-bold uppercase text-slate-500 block mb-1">Kwota przelewu</label>
                                <p class="font-bold text-[#1a2a52] text-lg">{{ this.transfer.amount }}</p>
                            </div>
                            <div>
                                <label class="text-[10px] font-bold uppercase text-slate-500 block mb-1">Data</label>
                                <p class="text-[#1a2a52] font-semibold text-sm">{{ this.transfer.transferredAt|date('d.m.Y') }}</p>
                            </div>
                        </div>
                    </div>

                    <div class="pt-4 border-t border-slate-100">
                        <label class="text-[10px] font-bold uppercase text-[#1a2a52] block mb-3"
                               for="payment-search">Wybierz płatność z listy</label>

                        {% set topHint = this.topHistoricalHint %}
                        {% if topHint %}
                            <div class="mb-4 p-4 rounded-xl bg-amber-50 border border-amber-200">
                                <p class="text-[10px] font-bold uppercase tracking-wider text-amber-700 mb-1">Sugestia na podstawie historii</p>
                                <p class="text-xs text-amber-900">{{ topHint.description }}</p>
                                <p class="text-[10px] text-amber-700 mt-1">Na podstawie {{ topHint.historicalMatchCount }} wcześniejszych dopasowań.</p>
                            </div>
                        {% endif %}
                        
                        <div class="relative mb-4">
                            <input
                                    id="payment-search"
                                    name="payment_search"
                                    type="text"
                                    data-model="paymentSearch"
                                    class="w-full rounded-xl border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:border-[#e8b441] focus:ring-[#e8b441] transition-all"
                                    placeholder="Szukaj po kodzie, nazwisku lub tytule..."
                            >
                        </div>

                        <div class="space-y-2 max-h-64 overflow-y-auto pr-2 custom-scroll">
                            {% set matchHints = this.matchHints %}
                            {% for payment in this.payments %}
                                {% set paymentHint = matchHints[payment.id.toRfc4122] ?? null %}
                                <div
                                        data-action="click->live#action"
                                        data-live-action-param="selectPayment"
                                        data-live-payment-id-param="{{ payment.id }}"
                                        class="p-4 border rounded-xl cursor-pointer transition-all {{ this.selectedPaymentId == payment.id ? 'bg-amber-50 border-[#e8b441] ring-1 ring-[#e8b441]' : (paymentHint ? 'bg-amber-50/40 border-amber-200 hover:border-amber-300' : 'bg-white border-slate-100 hover:border-slate-300') }}"
                                >
                                    <div class="flex justify-between items-center">
                                        <div class="flex-1">
                                            <div class="flex items-center gap-3 mb-1 flex-wrap">
                                                <p class="font-bold text-[#1a2a52] font-mono text-xs">{{ payment.paymentCode ? payment.paymentCode.code : 'BRAK KODU' }}</p>
                                                <span class="status-badge bg-slate-100 text-[#1a2a52] border border-slate-200">{{ payment.amount }}</span>
                                                {% if payment.amountMatch(this.transfer) %}
                                                    <span class="status-badge bg-emerald-50 text-emerald-600 border border-emerald-100">Kwota zgodna</span>
                                                {% endif %}
                                                {% if paymentHint %}
                                                    <span class="status-badge bg-amber-100 text-amber-800 border border-amber-200">Potencjalne dopasowanie</span>
                                                {% endif %}
                                            </div>
                                            <p class="text-xs font-semibold text-[#1a2a52]">{{ payment.label }}</p>
                                            {% if paymentHint %}
                                                <p class="text-[10px] text-amber-800 mt-1 font-medium">{{ paymentHint.description }}</p>
                                            {% endif %}
                                            <p class="text-[10px] text-[#6b7796] mt-1">{{ payment.user.name }} • {{ payment.user.email }}</p>
                                        </div>
                                        {% if this.selectedPaymentId == payment.id %}
                                            <div class="text-[#e8b441]">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                            {% else %}
                                <div class="rounded-xl border border-dashed border-slate-200 p-8 text-center text-[#6b7796] text-sm italic">
                                    Nie znaleziono oczekujących płatności pasujących do wyszukiwania.
                                </div>
                            {% endfor %}
                        </div>
                    </div>

                    <div class="flex justify-end gap-3 pt-4 border-t border-slate-100">
                        <button
                                data-action="click->live#action"
                                data-live-action-param="closeModal"
                                class="px-6 py-2.5 rounded-xl text-sm font-bold text-[#1a2a52] hover:bg-slate-50 transition-colors border border-slate-200"
                        >
                            Anuluj
                        </button>
                        <button
                                data-action="click->live#action"
                                data-live-action-param="confirmAssignment"
                                {{ this.selectedPaymentId is null ? 'disabled' : '' }}
                                class="px-6 py-2.5 rounded-xl text-sm font-bold text-white bg-[#1a2a52] hover:bg-[#2a4a7a] transition-all shadow-lg shadow-blue-900/10 disabled:opacity-50 disabled:cursor-not-allowed"
                        >
                            Zatwierdź i powiąż
                        </button>
                    </div>
                </div>
            {% endif %}

            <button type="button" data-action="click->live#action" data-live-action-param="closeModal"
                    class="absolute right-6 top-6 text-slate-400 hover:text-[#1a2a52] transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 6 6 18"></path>
                    <path d="m6 6 12 12"></path>
                </svg>
            </button>
        </div>
    {% endif %}
</div>
