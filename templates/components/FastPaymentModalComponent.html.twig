<div {{ attributes }}{% set sizeClasses = {
    'sm': 'rounded-sm text-xs py-1 px-2',
    'md': 'rounded-md text-sm py-2 px-4',
    'lg': 'rounded-md text-md py-2 px-4'
} %}{% if modalOpened %}data-modal-state="open" {% else %}data-modal-state="closed"{% endif %}
        {{ stimulus_controller('live', {
            url: path('ux_live_component', { _live_component: 'App\\UserInterface\\Http\\Component\\FastPaymentModalComponent' })
        }) }}
        {% if modalOpened and paymentId is not null and not isPaid %}data-live-poll="checkPaymentStatus"{% endif %}
>
    <button data-action="live#action"
            data-live-action-param="openModal"
            class="{% if this.size == 'lg' %}w-full py-5 flex items-center justify-center gap-3 shadow-xl shadow-amber-200/60 text-lg{% else %}{{ sizeClasses[this.size] }} inline-flex items-center justify-center gap-2{% endif %} whitespace-nowrap rounded-2xl font-bold ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:size-5 [&_svg]:shrink-0 bg-[#e8b441] text-[#1a2a52] hover:opacity-95 transition-all">
        {% if this.size == 'lg' %}
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="M2 10h20"/><path d="M7 15h.01"/><path d="M11 15h2"/></svg>
            Zapłać BLIKIEM
        {% else %}
            Szybka płatność
        {% endif %}
    </button>

    <!-- Modal Overlay -->
    <div data-action="click->live#action"
         data-live-action-param="closeModal"
         class="{% if not modalOpened %}hidden{% endif %} fixed inset-0 z-[100] bg-[#15203d]/60 backdrop-blur-md animate-in fade-in-0 duration-300"
         style="pointer-events: auto;" aria-hidden="true"></div>

    <!-- Modal Content -->
    <div {% if not modalOpened %}hidden{% endif %}
            class="fixed top-1/2 left-1/2 z-101 w-[calc(100%-2rem)] md:w-full -translate-x-1/2 -translate-y-1/2 gap-0 border-none bg-white p-0 shadow-2xl duration-300 rounded-[32px] max-w-lg overflow-hidden animate-in zoom-in-95"
            role="dialog"
            aria-modal="true">

        {% if paymentCode is not empty and paymentAmount is not empty %}
            {% if isPaid %}
                <div class="flex flex-col h-full z-102">
                    <!-- Header -->
                    <div class="bg-gradient-to-br from-green-500 to-emerald-600 p-8 text-white text-center relative overflow-hidden">
                        <div class="relative z-10">
                            <div class="w-20 h-20 bg-white/20 rounded-full flex items-center justify-center mx-auto mb-4 backdrop-blur-sm border border-white/30 animate-bounce">
                                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>
                            </div>
                            <h2 class="text-3xl font-serif-brand font-bold mb-1">Płatność zaksięgowana!</h2>
                            <p class="text-green-100 text-sm font-medium uppercase tracking-widest opacity-90">Dziękujemy za wpłatę</p>
                        </div>
                        <!-- Background Decoration -->
                        <div class="absolute top-[-20%] right-[-10%] w-40 h-40 bg-white/10 rounded-full blur-3xl"></div>
                        <div class="absolute bottom-[-20%] left-[-10%] w-32 h-32 bg-white/10 rounded-full blur-3xl"></div>
                    </div>

                    <div class="p-8">
                        <!-- Amount Card -->
                        <div class="bg-gradient-to-br from-green-50 to-emerald-50 border-2 border-green-200 rounded-3xl p-8 mb-8 text-center relative">
                            <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-green-500 text-white text-[10px] font-black px-6 py-2 rounded-full uppercase tracking-widest shadow-lg">
                                Zapłacono
                            </div>
                            <div class="text-6xl font-serif-brand font-bold text-green-700 mb-2">{{ paymentAmount|money }}</div>
                            <p class="text-green-600 text-sm font-medium">System automatycznie zaksięgował Twoją wpłatę</p>
                        </div>

                        <!-- Success Message -->
                        <div class="bg-green-50/50 border border-green-100 p-6 rounded-2xl mb-8 flex gap-4 items-start">
                            <svg width="24" height="24" fill="none" stroke="#16a34a" stroke-width="2" class="mt-0.5 flex-shrink-0"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/></svg>
                            <div>
                                <p class="text-sm font-bold text-green-800 mb-1">Wszystko w porządku!</p>
                                <p class="text-xs text-green-700 leading-relaxed">
                                    Twoja płatność została pomyślnie zaksięgowana. Skarbnik został powiadomiony o wpłacie.
                                </p>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="grid grid-cols-1 gap-3">
                            <button type="button"
                                    data-action="live#action"
                                    data-live-action-param="closeModal"
                                    class="w-full bg-gradient-to-r from-green-500 to-emerald-600 text-white py-4 rounded-2xl font-bold shadow-lg shadow-green-900/20 hover:opacity-90 transition-all active:scale-[0.98]">
                                Zamknij
                            </button>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="flex flex-col h-full z-102">
                    <!-- Header -->
                    <div class="bg-[#1a2a52] p-8 text-white text-center relative overflow-hidden">
                        <div class="relative z-10">
                            <div class="w-16 h-16 bg-white/10 rounded-2xl flex items-center justify-center mx-auto mb-4 backdrop-blur-sm border border-white/10">
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#e8b441" stroke-width="2.5"><path d="M22 2L11 13"/><path d="M22 2L15 22L11 13L2 9L22 2Z"/></svg>
                            </div>
                            <h2 class="text-2xl font-serif-brand font-bold mb-1">Płatność BLIK</h2>
                            <p class="text-blue-200 text-xs font-medium uppercase tracking-widest opacity-80">Szybkie rozliczenie</p>
                        </div>
                        <!-- Background Decoration -->
                        <div class="absolute top-[-20%] right-[-10%] w-32 h-32 bg-[#e8b441]/10 rounded-full blur-2xl"></div>
                    </div>

                    <div class="p-8">
                        <!-- Amount Card -->
                        <div class="bg-slate-50 border border-slate-100 rounded-3xl p-6 mb-8 text-center relative">
                            <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-[#e8b441] text-[#1a2a52] text-[10px] font-black px-4 py-1 rounded-full uppercase tracking-widest shadow-md">
                                Kwota do przelania
                            </div>
                            <div class="text-5xl font-serif-brand font-bold text-[#1a2a52]">{{ paymentAmount|money }}</div>
                        </div>

                        <!-- Instructions -->
                        <div class="space-y-6 mb-8">
                            <div class="group">
                                <p class="text-[10px] font-bold uppercase tracking-widest text-[#6b7796] mb-2 flex items-center gap-2">
                                    <span class="w-4 h-4 rounded-full bg-slate-200 text-[#1a2a52] flex items-center justify-center text-[8px]">1</span>
                                    Numer telefonu odbiorcy
                                </p>
                                <div class="text-xl font-bold text-[#1a2a52] flex items-center justify-between bg-white border border-slate-200 p-5 rounded-2xl shadow-sm group-hover:border-[#1a2a52] transition-colors">
                                    <span class="font-mono tracking-tight">{{ settings.getOptional('blik_phone', '791 234 567') }}</span>
                                    <button class="text-[10px] font-bold bg-slate-100 px-4 py-2 rounded-xl hover:bg-[#1a2a52] hover:text-white transition-all active:scale-95">Kopiuj</button>
                                </div>
                            </div>

                            <div class="group">
                                <p class="text-[10px] font-bold uppercase tracking-widest text-[#6b7796] mb-2 flex items-center gap-2">
                                    <span class="w-4 h-4 rounded-full bg-slate-200 text-[#1a2a52] flex items-center justify-center text-[8px]">2</span>
                                    Tytuł przelewu (Ważne!)
                                </p>
                                <div class="text-2xl font-mono font-bold text-red-500 tracking-[0.2em] flex items-center justify-between bg-red-50/30 border border-red-100 p-5 rounded-2xl shadow-sm group-hover:border-red-500 transition-colors">
                                    <span>{{ paymentCode }}</span>
                                    <button class="text-[10px] font-bold bg-red-100/50 text-red-700 px-4 py-2 rounded-xl hover:bg-red-500 hover:text-white transition-all active:scale-95">Kopiuj</button>
                                </div>
                            </div>
                        </div>

                        <!-- Info Alert -->
                        <div class="bg-blue-50/50 border border-blue-100 p-4 rounded-2xl mb-8 flex gap-3 items-start">
                            <svg width="20" height="20" fill="none" stroke="#2a4a7a" stroke-width="2" class="mt-0.5"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
                            <p class="text-[11px] text-[#2a4a7a] leading-relaxed font-medium">
                                Po wykonaniu przelewu system automatycznie wykryje wpłatę i powiadomi Skarbnika. Nie musisz przesyłać potwierdzenia.
                            </p>
                        </div>

                        <!-- Actions -->
                        <div class="grid grid-cols-1 gap-3">
                            <button type="button"
                                    data-action="live#action"
                                    data-live-action-param="closeModal"
                                    class="w-full bg-[#1a2a52] text-white py-4 rounded-2xl font-bold shadow-lg shadow-blue-900/20 hover:opacity-90 transition-all active:scale-[0.98]">
                                Gotowe, przelew wysłany
                            </button>

                            <div class="text-center pt-2">
                                 <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2">Alternatywnie</p>
                                 <p class="text-[10px] font-mono text-slate-400 break-all px-4">Konto: {{ settings.getOptional('transfer_account', '46 2490 0005 0000 4000 1897 5420') }}</p>
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}
        {% else %}
            <div class="p-12 text-center">
                <div class="w-20 h-20 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-6">
                    <svg width="40" height="40" fill="none" stroke="#cbd5e1" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
                </div>
                <h3 class="text-xl font-serif-brand font-bold text-[#1a2a52] mb-2">Brak zaległości</h3>
                <p class="text-sm text-[#6b7796] mb-8">Wszystkie Twoje składki zostały już opłacone. Dziękujemy!</p>
                <button type="button"
                        data-action="live#action"
                        data-live-action-param="closeModal"
                        class="btn-outline w-full !py-4 !rounded-2xl">
                    Zamknij
                </button>
            </div>
        {% endif %}
    </div>
</div>
