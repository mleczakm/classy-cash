<div {{ attributes }}>
    {% if not this.isSubmitted or not this.isSuccessful %}
        {{ form_start(form, {
            'attr': {
                'data-action': 'live#action:prevent',
                'data-live-action-param': 'save'
            }
        }) }}
        
        <div class="space-y-5">
            <label class="block text-[10px] font-bold uppercase tracking-widest text-[#1a2a52] mb-2">Adres Email</label>
            {{ form_widget(form.email, {
                'attr': {
                    'class': 'input-elegant bg-slate-50 focus:bg-white',
                    'placeholder': 'twoj@email.com'
                }
            }) }}
            <div class="text-red-500 text-sm mt-1">
                {{ form_errors(form.email) }}
            </div>
        </div>

        {% if this.usePassword %}
            <div class="mt-5">
                <div class="flex justify-between items-center mb-2">
                    <label class="text-[10px] font-bold uppercase tracking-widest text-[#1a2a52]">Hasło</label>
                    <a href="{{ path('app_reset_password_request') }}" class="text-[10px] font-bold text-gray-400 cursor-not-allowed" title="Resetowanie hasła zablokowane, zaloguj się za pomocą samego maila zamiast tego" disabled>Zapomniałeś hasła?</a>
                </div>
                {{ form_widget(form.password, {
                    'attr': {
                        'class': 'input-elegant bg-slate-50 focus:bg-white',
                        'placeholder': '••••••••'
                    }
                }) }}
                <div class="text-red-500 text-sm mt-1">
                    {{ form_errors(form.password) }}
                </div>
            </div>
        {% endif %}

        <div class="pt-4 space-y-4">
            {{ form_widget(form.submit, {
                'attr': {
                    'class': 'w-full btn-primary shadow-lg shadow-blue-900/20 cursor-pointer'
                }
            }) }}

            <div class="text-center">
                <button type="button" 
                        data-action="live#action" 
                        data-live-action-param="togglePassword" 
                        class="text-sm font-bold text-[#6b7796] hover:text-[#1a2a52] transition-colors cursor-pointer">
                    {% if this.usePassword %}
                        Zaloguj się linkiem email
                    {% else %}
                        Zaloguj się hasłem
                    {% endif %}
                </button>
            </div>
        </div>
        
        {{ form_end(form) }}
    {% else %}
        <div class="w-full max-w-md card-elegant shadow-2xl text-center py-16 px-10 animate-in">
            <div class="w-24 h-24 bg-[#e6f5ee] rounded-full flex items-center justify-center mx-auto mb-10 relative">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#2aa57f" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="relative z-10"><path d="M22 2L11 13"></path><path d="M22 2L15 22L11 13L2 9L22 2Z"></path></svg>
                <div class="absolute inset-0 bg-[#2aa57f]/20 rounded-full animate-ping opacity-25"></div>
            </div>

            <h2 class="text-4xl font-serif-brand font-bold text-[#1a2a52] mb-4">Sprawdź skrzynkę</h2>
            <p class="text-[#6b7796] mb-2 font-medium">Właśnie wysłaliśmy magiczny link na adres:</p>
            <div class="bg-slate-50 border border-slate-100 px-4 py-3 rounded-xl inline-block mb-10">
                <span id="target-email" class="font-bold text-[#1a2a52] font-mono">{{ this.submittedEmail }}</span>
            </div>

            <div class="space-y-4">
                {% set webmail = this.getWebmailInfo() %}
                <a href="{{ webmail.url }}" target="_blank" class="w-full btn-primary h-14 flex items-center justify-center gap-3">
                    <svg width="20" height="20" fill="white" viewBox="0 0 24 24"><path d="M24 4.5v15c0 .85-.65 1.5-1.5 1.5H21V7.387l-9 6.463-9-6.463V21H1.5C.65 21 0 20.35 0 19.5v-15c0-.425.162-.8.431-1.068C.7 3.16 1.075 3 1.5 3H2l10 7.25L22 3h.5c.425 0 .8.162 1.069.432.27.268.431.643.431 1.068z"></path></svg>
                    Otwórz {{ webmail.name }}
                </a>
                <p class="text-xs text-[#6b7796] px-6">Kliknij w przycisk w otrzymanej wiadomości, aby zalogować się bezpiecznie bez użycia hasła.</p>
            </div>

            <div class="mt-12 pt-8 border-t border-slate-100 flex flex-col gap-4">
                <button 
                    data-action="live#action" 
                    data-live-action-param="resendEmail" 
                    class="text-sm font-bold text-[#1a2a52] hover:text-[#e8b441] transition-colors cursor-pointer"
                >
                    Nie dotarł e-mail? Wyślij ponownie
                </button>
                <button 
                    data-action="live#action" 
                    data-live-action-param="changeEmail" 
                    class="text-[10px] font-bold uppercase tracking-widest text-[#6b7796] hover:text-[#1a2a52] cursor-pointer"
                >
                    Zmień adres e-mail
                </button>
            </div>
        </div>
    {% endif %}
</div>
