<div {{ attributes }}>
    {% if not this.isSubmitted or not this.isSuccessful %}
        {{ form_start(form, {
            'attr': {
                'data-action': 'live#action:prevent',
                'data-live-action-param': 'save'
            }
        }) }}
        <div class="form-group">
            {{ form_label(form.email, 'form.register.email', {'label_attr': {'class': ''}}) }}
            <div class="input-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>
                {{ form_widget(form.email, {'attr': {
                    'class': 'input',
                    'placeholder': 'form.register.email.placeholder'|trans
                }}) }}
            </div>
            <div class="text-danger text-sm mt-1">
                {{ form_errors(form.email) }}
            </div>
        </div>

        {{ form_widget(form.submit, {'label': 'form.login.submit'|trans ~ ' →', 'attr': {'class': 'btn btn-primary btn-block', 'style': 'margin-top:18px'}}) }}
        {{ form_end(form) }}
    {% else %}
        <div class="card text-center p-8">
            <div class="rounded-full bg-success/10 p-4 inline-block mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
            </div>
            <h2 class="text-2xl font-bold mb-4">{{ 'form.login.success.title'|trans }}</h2>
            <p class="text-muted-foreground mb-6">{{ 'form.login.success.message'|trans }}</p>
        </div>
    {% endif %}
</div>
