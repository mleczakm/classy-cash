parameters:
	ignoreErrors:
		-
			message: '#^Expression on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.expr
			count: 1
			path: src/Application/CommandHandler/ImportTransfersFromMailHandler.php

		-
			message: '#^PHPDoc tag @var with type DirectoryTree\\ImapEngine\\Message is not subtype of native type DirectoryTree\\ImapEngine\\MessageQueryInterface\.$#'
			identifier: varTag.nativeType
			count: 1
			path: src/Application/CommandHandler/ImportTransfersFromMailHandler.php

		-
			message: '#^Method App\\Application\\CommandHandler\\SendLoginNotificationHandler\:\:__construct\(\) has parameter \$userProvider with generic interface Symfony\\Component\\Security\\Core\\User\\UserProviderInterface but does not specify its types\: TUser$#'
			identifier: missingType.generics
			count: 1
			path: src/Application/CommandHandler/SendLoginNotificationHandler.php

		-
			message: '#^Method App\\Entity\\User\:\:getUserIdentifier\(\) should return non\-empty\-string but returns string\.$#'
			identifier: return.type
			count: 1
			path: src/Entity/User.php

		-
			message: '#^Call to an undefined method DirectoryTree\\ImapEngine\\Connection\\ImapQueryBuilder\:\:withHeaders\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Infrastructure/ImapEngine/AliorNotificationMailProvider.php

		-
			message: '#^Call to function method_exists\(\) with App\\Entity\\ClassCouncil\\StudentPayment and ''markPaid'' will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Infrastructure/Symfony/EventSubscriber/StudentPaymentSettlementSubscriber.php

		-
			message: '#^Call to function method_exists\(\) with App\\Entity\\User and ''getEmail'' will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Infrastructure/Symfony/EventSubscriber/StudentPaymentSettlementSubscriber.php

		-
			message: '#^Method App\\Repository\\ClassCouncil\\ClassExpenseRepository\:\:findByClass\(\) should return array\<int, App\\Entity\\ClassCouncil\\ClassExpense\> but returns mixed\.$#'
			identifier: return.type
			count: 1
			path: src/Repository/ClassCouncil/ClassExpenseRepository.php

		-
			message: '#^Method App\\Repository\\ClassCouncil\\StudentPaymentRepository\:\:findByPayment\(\) should return array\<int, App\\Entity\\ClassCouncil\\StudentPayment\> but returns mixed\.$#'
			identifier: return.type
			count: 1
			path: src/Repository/ClassCouncil/StudentPaymentRepository.php

		-
			message: '#^Method App\\Repository\\ClassCouncil\\StudentPaymentRepository\:\:findForStudents\(\) should return array\<int, App\\Entity\\ClassCouncil\\StudentPayment\> but returns mixed\.$#'
			identifier: return.type
			count: 1
			path: src/Repository/ClassCouncil/StudentPaymentRepository.php

		-
			message: '#^Generator expects value type DirectoryTree\\ImapEngine\\MessageQueryInterface, DirectoryTree\\ImapEngine\\MessageInterface given\.$#'
			identifier: generator.valueType
			count: 1
			path: tests/Application/CommandHandler/ImportTransfersFromMailHandlerTest.php

		-
			message: '#^Unreachable statement \- code above always terminates\.$#'
			identifier: deadCode.unreachable
			count: 1
			path: tests/Functional/Component/OnboardingTest.php

		-
			message: '#^Unreachable statement \- code above always terminates\.$#'
			identifier: deadCode.unreachable
			count: 5
			path: tests/UserInterface/LiveComponent/Treasurer/Students/AddStudentComponentTest.php
